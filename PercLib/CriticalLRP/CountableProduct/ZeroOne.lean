/-
Kolmogorov's zero–one law for the event "an infinite cluster exists", and its
consequences for the critical parameter.

Source: Tom Hutchcroft, *Critical long-range percolation I: High effective dimension*,
arXiv:2508.18807v1, §I.1.2 p. 6: `β_c := inf{β ≥ 0 : an infinite cluster exists
P_β-a.s.}`.  The event "an infinite cluster exists" is a *tail* event of the
independent-edge product measure (it is unchanged by changing finitely many edges), so by
Kolmogorov's zero–one law it has probability `0` or `1`.

The proof strategy follows `ProductMeasure/TailProduct.lean` and
`Clusters/PercolationTail.lean` of the public `openai/math` repository (commit
4eaee87548250b2682affda7d05d947c05554bae, Apache 2.0), ported to Lean 4.35.0 and to this
development's definitions of cluster and of the percolation event.

No `sorry`, no custom axioms.
-/
module

public import Mathlib
public import PercLib.CriticalLRP.CountableProduct.Base
public import PercLib.CriticalLRP.CountableProduct.Marks

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false
set_option linter.unusedTactic false
set_option linter.unusedVariables false

set_option autoImplicit true

set_option linter.unusedSectionVars false

@[expose] public section

open MeasureTheory Measure ProbabilityTheory unitInterval
open scoped ENNReal

namespace PercLib.CriticalLRP

section Tail

variable {V : Type*} [Countable V]

/-- The σ-algebra generated by the state of a single edge. -/
abbrev coordinateSigma (e : Sym2 V) : MeasurableSpace (Config V) :=
  MeasurableSpace.comap (fun ω : Config V => e ∈ ω) inferInstance

/-- The σ-algebra generated by the states of the edges in `S`. -/
abbrev blockSigma (S : Set (Sym2 V)) : MeasurableSpace (Config V) := ⨆ e ∈ S, coordinateSigma e

theorem coordinateSigma_le (e : Sym2 V) :
    coordinateSigma e ≤ (Set.instMeasurableSpace : MeasurableSpace (Config V)) := by
  have h : Measurable fun ω : Config V => e ∈ ω :=
    measurable_to_prop (by simpa using measurableSet_mem e)
  exact measurable_iff_comap_le.mp h

theorem blockSigma_le (S : Set (Sym2 V)) :
    blockSigma S ≤ (Set.instMeasurableSpace : MeasurableSpace (Config V)) :=
  iSup₂_le fun e _ => coordinateSigma_le e

theorem independent_coordinates (π : Sym2 V → unitInterval) :
    iIndep coordinateSigma (edgeMeasure π) :=
  (iIndepFun_iff_iIndep _ _ _).1 (iIndepFun_edgeMeasure π)

/-- Edges in `S` and edges outside `S` are independent. -/
theorem independent_blocks (π : Sym2 V → unitInterval) (S : Set (Sym2 V)) :
    Indep (blockSigma S) (blockSigma Sᶜ) (edgeMeasure π) :=
  indep_biSup_compl coordinateSigma_le (independent_coordinates π) S

/-- Replace the states of the edges in `S` by those of `η`, keeping `ω` elsewhere. -/
def forceOn (S : Set (Sym2 V)) (η ω : Config V) : Config V :=
  (ω \ S) ∪ (η ∩ S)

theorem measurable_forceOn_block (S η : Set (Sym2 V)) :
    @Measurable (Config V) (Config V) (blockSigma Sᶜ) (Set.instMeasurableSpace)
      (forceOn S η) := by
  classical
  classical
  refine (@measurable_pi_iff (Config V) (Sym2 V) (fun _ => Prop) (blockSigma Sᶜ)
    (fun _ => inferInstance) _).mpr ?_
  intro e
  by_cases he : e ∈ S
  · have hconst : (fun ω : Config V => (forceOn S η ω) e) = fun _ => (e ∈ η) := by
      funext ω
      apply propext
      change e ∈ forceOn S η ω ↔ e ∈ η
      simp [forceOn, he]
    rw [hconst]
    exact measurable_const
  · have hid : (fun ω : Config V => (forceOn S η ω) e) = fun ω => e ∈ ω := by
      funext ω
      apply propext
      change e ∈ forceOn S η ω ↔ e ∈ ω
      simp [forceOn, he]
    rw [hid]
    have hm : @Measurable (Config V) Prop (coordinateSigma e) inferInstance
        (fun ω => e ∈ ω) := measurable_iff_comap_le.mpr le_rfl
    have hl : coordinateSigma e ≤ blockSigma Sᶜ :=
      le_iSup_of_le e (le_iSup_of_le (by simpa using he) le_rfl)
    exact hm.mono hl le_rfl

theorem measurable_forceOn (S η : Set (Sym2 V)) : Measurable (forceOn S η) :=
  (measurable_forceOn_block S η).mono (blockSigma_le Sᶜ) le_rfl

/-- **Kolmogorov's zero–one law**, in the form needed here: an event of the configuration
which is unchanged by changing finitely many edge states has probability `0` or `1`. -/
theorem zero_one_of_finite_erasure_invariant (π : Sym2 V → unitInterval)
    (A : Set (Config V)) (hA : MeasurableSet A)
    (hinv : ∀ (S : Set (Sym2 V)), S.Finite → ∀ ω, forceOn S ∅ ω ∈ A ↔ ω ∈ A) :
    edgeMeasure π A = 0 ∨ edgeMeasure π A = 1 := by
  classical
  let mA : MeasurableSpace (Config V) := MeasurableSpace.generateFrom {A}
  have hmA : mA ≤ (Set.instMeasurableSpace : MeasurableSpace (Config V)) := by
    refine MeasurableSpace.generateFrom_le ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    exact hA
  have hi : ∀ S : Finset (Sym2 V), Indep (blockSigma (S : Set (Sym2 V))) mA (edgeMeasure π) := by
    intro S
    have htail : MeasurableSet[blockSigma (S : Set (Sym2 V))ᶜ] A := by
      have hh := hA.preimage (measurable_forceOn_block (S : Set (Sym2 V)) ∅)
      have heq : forceOn (S : Set (Sym2 V)) ∅ ⁻¹' A = A := by
        ext ω
        exact hinv _ S.finite_toSet ω
      rwa [heq] at hh
    have hle : mA ≤ blockSigma (S : Set (Sym2 V))ᶜ := by
      refine MeasurableSpace.generateFrom_le ?_
      intro t ht
      rw [Set.mem_singleton_iff] at ht
      subst ht
      exact htail
    exact indep_of_indep_of_le_right (independent_blocks π (S : Set (Sym2 V))) hle
  have hd : Directed (· ≤ ·) (fun S : Finset (Sym2 V) => blockSigma (S : Set (Sym2 V))) := by
    intro S T
    refine ⟨S ∪ T, ?_, ?_⟩ <;> apply iSup₂_le <;> intro e he
    · exact le_iSup_of_le e (le_iSup_of_le (Finset.mem_union_left T he) le_rfl)
    · exact le_iSup_of_le e (le_iSup_of_le (Finset.mem_union_right S he) le_rfl)
  have hall : (⨆ S : Finset (Sym2 V), blockSigma (S : Set (Sym2 V))) =
      (Set.instMeasurableSpace : MeasurableSpace (Config V)) := by
    refine le_antisymm (iSup_le fun S => blockSigma_le _) ?_
    change (⨆ e, coordinateSigma e) ≤ _
    refine iSup_le fun e => ?_
    exact le_iSup_of_le {e} (le_iSup_of_le e (le_iSup_of_le (Finset.mem_singleton_self e) le_rfl))
  have h := indep_iSup_of_directed_le (m1 := mA) hi
    (fun S => blockSigma_le (S : Set (Sym2 V))) hmA hd
  rw [hall] at h
  exact measure_eq_zero_or_one_of_indepSet_self
    (h.indepSet_of_measurableSet hA (MeasurableSpace.measurableSet_generateFrom (by simp)))

end Tail

/-! ## Finite changes of the configuration do not create or destroy infinite clusters -/

section FiniteChange

variable {V : Type*} [Countable V]

/-- Opening the extra edges in `S` only merges clusters and adds the endpoints of edges of
`S` to the cluster of `o`. -/
theorem cluster_union_subset (ω S : Set (Sym2 V)) (o : V) :
    cluster (ω ∪ S) o ⊆
      cluster ω o ∪ ⋃ e ∈ S, ⋃ v ∈ {v : V | v ∈ e}, cluster ω v := by
  classical
  have key : ∀ {a b : V} (p : (openGraph (ω ∪ S)).Walk a b),
      b ∈ cluster ω a ∪ ⋃ e ∈ S, ⋃ v ∈ {v : V | v ∈ e}, cluster ω v := by
    intro a b p
    induction p with
    | nil => exact Or.inl (cluster_mem_self ω _)
    | @cons u v w hadj q ih =>
      rw [openGraph_adj] at hadj
      obtain ⟨hne, hmem⟩ := hadj
      rcases ih with h1 | h2
      · rcases hmem with hω | hS
        · refine Or.inl ?_
          have hconn : Connects ω u v := (openGraph_adj.mpr ⟨hne, hω⟩).reachable
          rw [cluster_eq_iff.mpr hconn]
          exact h1
        · refine Or.inr (Set.mem_iUnion₂.mpr ⟨s(u, v), hS,
            Set.mem_iUnion₂.mpr ⟨v, by simp, h1⟩⟩)
      · exact Or.inr h2
  intro z hz
  rw [mem_cluster_iff] at hz
  obtain ⟨p⟩ := hz
  exact key p

/-- Adding a finite set of open edges does not change whether an infinite cluster exists. -/
theorem existsInfiniteCluster_union_finite_iff (ω : Config V) (S : Set (Sym2 V)) (hS : S.Finite) :
    (ω ∪ S ∈ existsInfiniteClusterEvent V) ↔ (ω ∈ existsInfiniteClusterEvent V) := by
  classical
  constructor
  · rintro ⟨o, ho⟩
    have ho' : (cluster (ω ∪ S) o).Infinite := (inInfiniteCluster_iff_infinite _ o).mp ho
    by_contra hω
    have hfinite : ∀ v, (cluster ω v).Finite := fun v =>
      Set.not_infinite.1 fun hv => hω ⟨v, (inInfiniteCluster_iff_infinite ω v).mpr hv⟩
    have hfin : (cluster ω o ∪ ⋃ e ∈ S, ⋃ v ∈ {v : V | v ∈ e}, cluster ω v).Finite := by
      refine Set.Finite.union (hfinite o) ?_
      refine hS.biUnion fun e _ => ?_
      have hset : ({v : V | v ∈ e} : Set V) = ↑(e.toFinset) := by
        ext v; simp
      rw [hset]
      exact (e.toFinset.finite_toSet).biUnion fun v _ => hfinite v
    exact ho' (hfin.subset (cluster_union_subset ω S o))
  · rintro ⟨o, ho⟩
    exact ⟨o, (inInfiniteCluster_iff_infinite (ω ∪ S) o).mpr
      ((inInfiniteCluster_iff_infinite ω o).mp ho |>.mono (cluster_mono Set.subset_union_left o))⟩

/-- Closing a finite set of edges does not change whether an infinite cluster exists. -/
theorem existsInfiniteCluster_diff_finite_iff (ω : Config V) (S : Set (Sym2 V)) (hS : S.Finite) :
    (ω \ S ∈ existsInfiniteClusterEvent V) ↔ (ω ∈ existsInfiniteClusterEvent V) := by
  constructor
  · rintro ⟨o, ho⟩
    exact ⟨o, (inInfiniteCluster_iff_infinite ω o).mpr
      ((inInfiniteCluster_iff_infinite _ o).mp ho |>.mono (cluster_mono Set.sdiff_subset o))⟩
  · intro hω
    have hsub : ω ⊆ (ω \ S) ∪ S := by
      intro e he
      by_cases hs : e ∈ S
      · exact Or.inr hs
      · exact Or.inl ⟨he, hs⟩
    have h1 : (ω \ S) ∪ S ∈ existsInfiniteClusterEvent V := by
      obtain ⟨o, ho⟩ := hω
      exact ⟨o, (inInfiniteCluster_iff_infinite _ o).mpr
        ((inInfiniteCluster_iff_infinite ω o).mp ho |>.mono (cluster_mono hsub o))⟩
    exact (existsInfiniteCluster_union_finite_iff (ω \ S) S hS).mp h1

end FiniteChange

/-! ## The percolation event has probability zero or one -/

section ZeroOne

variable {V : Type*} [Countable V]

theorem forceOn_empty_eq (S : Set (Sym2 V)) (ω : Config V) : forceOn S ∅ ω = ω \ S := by
  classical
  ext e
  by_cases he : e ∈ S <;>
    simp only [forceOn, Set.mem_union, Set.mem_sdiff, Set.mem_inter_iff, he, not_true, and_false,
      true_and, false_or, false_and, not_false_eq_true, and_true, Set.notMem_empty, or_false]

/-- **The probability that an infinite cluster exists is `0` or `1`.** -/
theorem percolationEventProb_zero_or_one (J : Sym2 V → ℝ) (hJ : ∀ e, 0 ≤ J e) (β : NNReal) :
    infiniteClusterProb J hJ β = 0 ∨ infiniteClusterProb J hJ β = 1 := by
  refine zero_one_of_finite_erasure_invariant (bernoulliEdgeProb J hJ β)
    (existsInfiniteClusterEvent V) measurableSet_existsInfiniteCluster ?_
  intro S hS ω
  rw [forceOn_empty_eq, existsInfiniteCluster_diff_finite_iff ω S hS]

/-- `P_β` of an infinite cluster is either `0` or `1`, so it is `1` as soon as it is
positive. -/
theorem infiniteClusterProb_eq_one_of_pos {J : Sym2 V → ℝ} (hJ : ∀ e, 0 ≤ J e) {β : NNReal}
    (h : 0 < infiniteClusterProb J hJ β) : infiniteClusterProb J hJ β = 1 :=
  (percolationEventProb_zero_or_one J hJ β).resolve_left (ne_of_gt h)

/-- `β` percolates (`P_β(∃ infinite cluster) = 1`) iff `P_β(∃ infinite cluster) > 0`. -/
theorem infiniteClusterProb_eq_one_iff_pos {J : Sym2 V → ℝ} (hJ : ∀ e, 0 ≤ J e) {β : NNReal} :
    infiniteClusterProb J hJ β = 1 ↔ 0 < infiniteClusterProb J hJ β := by
  constructor
  · intro h; rw [h]; exact one_pos
  · exact infiniteClusterProb_eq_one_of_pos hJ

/-- Union bound: the probability that an infinite cluster exists is at most the sum of the
percolation probabilities. -/
theorem percolationEventProb_le_tsum (π : Sym2 V → unitInterval) :
    percolationEventProb π ≤ ∑' v : V, percolationProb π v := by
  simp only [percolationEventProb, percolationProb]
  refine le_trans (measure_mono ?_)
    (measure_iUnion_le (s := fun v : V => {ω : Config V | InInfiniteCluster ω v}))
  intro ω hω
  exact Set.mem_iUnion.mpr hω

/-- **No infinite cluster a.s. iff every vertex has `θ = 0`** (countable union bound); this is
the identity between the paper's a.s. formulation and the usual `θ > 0` formulation of
percolation. -/
theorem infiniteClusterProb_eq_zero_iff_forall {J : Sym2 V → ℝ} (hJ : ∀ e, 0 ≤ J e)
    {β : NNReal} :
    infiniteClusterProb J hJ β = 0 ↔ ∀ v : V, percolationFunction J hJ β v = 0 := by
  constructor
  · intro h v
    have hle := percolationProb_le_percolationEventProb (bernoulliEdgeProb J hJ β) v
    have h0 : percolationEventProb (bernoulliEdgeProb J hJ β) = 0 := h
    exact le_antisymm (h0 ▸ hle) zero_le
  · intro h
    have hle : infiniteClusterProb J hJ β ≤ ∑' v : V, percolationFunction J hJ β v :=
      percolationEventProb_le_tsum (bernoulliEdgeProb J hJ β)
    have hsum : (∑' v : V, percolationFunction J hJ β v) = 0 := by
      simp [h]
    rw [hsum] at hle
    exact le_antisymm hle zero_le

end ZeroOne

end PercLib.CriticalLRP
