/-
# The mixed ghost-restoration error, part 1: block independence of the ghost field

This file supplies the piece of infrastructure that the ghost/restoration estimate (I.3.5) of
Hutchcroft, *Critical long-range percolation I*, needs and that the existing development
(`GhostField`, `GhostCoupling`, `RestorationLaw`, `LastExit`) does not yet have: the
**factorisation of the ghost field over a fixed vertex set**.

The pattern is exactly the one already used for the edge law (`ZeroOne.lean`,
`RestorationCompl.lean`): the ghost field is `Measure.infinitePi` of Bernoulli laws, hence

* the single-vertex σ-algebras `ghostSigma v = comap (fun G => G v)` are independent
  (`iIndepFun_infinitePi`),
* so the σ-algebras generated by `v ∈ K` and by `v ∉ K` are independent for every `K`
  (`indep_biSup_compl`),
* so an ``avoid `K`'' indicator times a function of the marks outside `K` factors:
  `∫ avoid_K · f = P(avoid_K) · ∫ f`, with `P(avoid_K) = ∏'_{v ∈ K} (1-p) = e^{-h|K|}`.

This is the honest version of the paper's "exploring the cluster of the origin reveals only
negative information about connectivity to the ghost off of this cluster": the marks on `K`
are independent of the marks off `K`, and the negative information is exactly the factor
`P(ghost avoids K) = e^{-h|K|}`.

No `sorry`, no `admit`, no new axioms.
-/
module

public import PercLib.CriticalLRP.CountableProduct.GhostField
public import PercLib.CriticalLRP.CountableProduct.GhostCoupling
public import PercLib.CriticalLRP.CountableProduct.LastExit
public import PercLib.CriticalLRP.CountableProduct.RestorationLaw
public import PercLib.CriticalLRP.CountableProduct.GhostCutoffCounterexample

set_option autoImplicit true

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1200000

@[expose] public section

open MeasureTheory Measure ProbabilityTheory unitInterval
open scoped ENNReal NNReal

namespace PercLib.CriticalLRP

attribute [local instance] Classical.propDecidable

variable {V : Type*} [Countable V]

/-! ## The σ-algebra of the marks in a set of vertices -/

/-- The σ-algebra generated by the ghost mark of a single vertex. -/
abbrev ghostSigma (v : V) : MeasurableSpace (V → Prop) :=
  MeasurableSpace.comap (fun G : V → Prop => G v) inferInstance

/-- The σ-algebra generated by the ghost marks of the vertices in `S`. -/
abbrev ghostBlockSigma (S : Set V) : MeasurableSpace (V → Prop) := ⨆ v ∈ S, ghostSigma v

theorem ghostSigma_le (v : V) : ghostSigma (V := V) v ≤ (inferInstance : MeasurableSpace (V → Prop)) := by
  have h : Measurable fun G : V → Prop => G v := measurable_pi_apply v
  exact measurable_iff_comap_le.mp h

theorem ghostBlockSigma_le (S : Set V) :
    ghostBlockSigma (V := V) S ≤ (inferInstance : MeasurableSpace (V → Prop)) :=
  iSup₂_le fun v _ => ghostSigma_le v

theorem measurable_ghost_eval {S : Set V} {v : V} (hv : v ∈ S) :
    Measurable[ghostBlockSigma S] fun G : V → Prop => G v :=
  measurable_iff_comap_le.mpr (le_iSup_of_le v (le_iSup_of_le hv le_rfl))

/-- **The single-vertex marks of the ghost field are independent.** -/
theorem independent_ghost_coordinates (h : ℝ≥0) :
    iIndep (ghostSigma (V := V)) (ghostLaw h) :=
  iIndepFun_infinitePi (X := fun _ (b : Prop) => b) (fun _ => measurable_id)

/-- **Marks on `S` and marks outside `S` are independent.** -/
theorem independent_ghost_blocks (h : ℝ≥0) (S : Set V) :
    Indep (ghostBlockSigma S) (ghostBlockSigma Sᶜ) (ghostLaw h) :=
  indep_biSup_compl ghostSigma_le (independent_ghost_coordinates h) S

/-- Replace the marks on `S` by those of `G'`, keeping `G` elsewhere. -/
def ghostForceOn (S : Set V) (G' G : V → Prop) : V → Prop :=
  fun v => if v ∈ S then G' v else G v

theorem ghostForceOn_apply_of_mem {S : Set V} {v : V} (hv : v ∈ S) (G' G : V → Prop) :
    ghostForceOn S G' G v = G' v := by
  simp only [ghostForceOn, hv, ite_true]

theorem ghostForceOn_apply_of_notMem {S : Set V} {v : V} (hv : v ∉ S) (G' G : V → Prop) :
    ghostForceOn S G' G v = G v := by
  simp only [ghostForceOn, hv, ite_false]

theorem measurable_ghostForceOn_block (S : Set V) (G' : V → Prop) :
    @Measurable (V → Prop) (V → Prop) (ghostBlockSigma Sᶜ) (inferInstance)
      (ghostForceOn S G') := by
  refine (@measurable_pi_iff (V → Prop) V (fun _ => Prop) (ghostBlockSigma Sᶜ)
    (fun _ => inferInstance) _).mpr ?_
  intro v
  by_cases hv : v ∈ S
  · have hconst : (fun G : V → Prop => ghostForceOn S G' G v) = fun _ => G' v := by
      funext G; exact ghostForceOn_apply_of_mem hv G' G
    rw [hconst]
    exact measurable_const
  · have hid : (fun G : V → Prop => ghostForceOn S G' G v) = fun G => G v := by
      funext G; exact ghostForceOn_apply_of_notMem hv G' G
    rw [hid]
    exact measurable_ghost_eval (S := Sᶜ) (by simpa using hv)

/-- A measurable function which only sees the marks outside `S` is measurable for
`ghostBlockSigma Sᶜ`. -/
theorem measurable_ghostBlockSigma_compl_of_forget {S : Set V} {f : (V → Prop) → ℝ≥0∞}
    (hf : Measurable f)
    (hinv : ∀ G G' : V → Prop, (∀ v, v ∉ S → (G' v ↔ G v)) → f G' = f G) :
    Measurable[ghostBlockSigma Sᶜ] f := by
  have h := hf.comp (measurable_ghostForceOn_block S (fun _ => False))
  convert h using 1
  funext G
  exact (hinv G (ghostForceOn S (fun _ => False) G)
    (fun v hv => by rw [ghostForceOn_apply_of_notMem hv])).symm

/-! ## The avoidance indicator of a finite vertex set -/

/-- ``The ghost field avoids the finite set `K`''. -/
def ghostAvoids (K : Finset V) : Set (V → Prop) := {G | ∀ v ∈ K, ¬ G v}

/-- The indicator function of ``the ghost field avoids `K`''. -/
noncomputable def ghostAvoidInd (K : Finset V) : (V → Prop) → ℝ≥0∞ :=
  (ghostAvoids K).indicator (fun _ => (1 : ℝ≥0∞))

theorem prod_avoidInd (K : Finset V) (G : V → Prop) :
    (∏ v ∈ K, if ¬ G v then (1 : ℝ≥0∞) else 0) = ghostAvoidInd K G := by
  classical
  rw [ghostAvoidInd, Finset.prod_boole]
  simp [ghostAvoids, Set.indicator_apply]

theorem measurableSet_ghostAvoids_block (K : Finset V) :
    MeasurableSet[ghostBlockSigma (K : Set V)] (ghostAvoids K) := by
  have hset : ghostAvoids (V := V) K
      = ⋂ v ∈ K, {G : V → Prop | G v ∈ ({q : Prop | ¬ q} : Set Prop)} := by
    ext G; simp [ghostAvoids]
  rw [hset]
  exact Finset.measurableSet_biInter K fun v hv =>
    (measurable_ghost_eval (S := (K : Set V)) (Finset.mem_coe.mpr hv))
      (t := {q : Prop | ¬ q}) (by measurability)

theorem measurable_ghostAvoidInd_block (K : Finset V) :
    Measurable[ghostBlockSigma (K : Set V)] (ghostAvoidInd K) :=
  Measurable.indicator measurable_const (measurableSet_ghostAvoids_block K)

theorem measurableSet_ghostAvoids (K : Finset V) : MeasurableSet (ghostAvoids (V := V) K) := by
  have h : ghostAvoids (V := V) K
      = Set.pi (K : Set V) (fun _ => {q : Prop | ¬ q}) := by
    ext G; simp [ghostAvoids]
  rw [h]
  exact measurableSet_absent (K : Set V)

/-- The probability that the ghost field avoids a finite set: `e^{-h|K|}`. -/
theorem ghostLaw_avoid_finset (h : ℝ≥0) (K : Finset V) :
    ghostLaw h (ghostAvoids (V := V) K) = ghostW h ^ K.card := by
  have hset : ghostAvoids (V := V) K = Set.pi (K : Set V) (fun _ => {q : Prop | ¬ q}) := by
    ext G; simp [ghostAvoids]
  rw [hset, ghostLaw_pi]
  have : Fintype ↥(K : Set V) := K.finite_toSet.fintype
  rw [tprod_fintype, Finset.prod_const]
  congr 1
  simp

/-- **The avoidance factorisation.**  The probability that the ghost avoids the finite set `K`
*and* satisfies a property of the marks outside `K` is `e^{-h|K|}` times the probability of that
property.  This is the exact form of ``exploring `K` reveals only negative information about the
ghost outside `K`''. -/
theorem lintegral_ghostAvoid_mul (h : ℝ≥0) (K : Finset V)
    {f : (V → Prop) → ℝ≥0∞} (hf : Measurable f)
    (hinv : ∀ G G' : V → Prop, (∀ v, v ∉ (K : Set V) → (G' v ↔ G v)) → f G' = f G) :
    ∫⁻ G, ghostAvoidInd K G * f G ∂(ghostLaw h)
      = ghostW h ^ K.card * ∫⁻ G, f G ∂(ghostLaw h) := by
  have hfblock : Measurable[ghostBlockSigma ((K : Set V))ᶜ] f :=
    measurable_ghostBlockSigma_compl_of_forget hf hinv
  have hind : Indep (ghostBlockSigma (K : Set V)) (ghostBlockSigma ((K : Set V))ᶜ)
      (ghostLaw h) := independent_ghost_blocks h (K : Set V)
  have hkey := lintegral_mul_eq_lintegral_mul_lintegral_of_independent_measurableSpace
    (μ := ghostLaw h) (ghostBlockSigma_le (K : Set V)) (ghostBlockSigma_le _) hind
    (measurable_ghostAvoidInd_block K) hfblock
  rw [hkey, ghostAvoidInd, lintegral_indicator (measurableSet_ghostAvoids K),
    setLIntegral_one, ghostLaw_avoid_finset]

/-- The same factorisation in the form of a measure of an intersection. -/
theorem ghostLaw_avoid_inter (h : ℝ≥0) (K : Finset V) {C : Set (V → Prop)}
    (hC : MeasurableSet C)
    (hinv : ∀ G G' : V → Prop, (∀ v, v ∉ (K : Set V) → (G' v ↔ G v)) → (G ∈ C → G' ∈ C)) :
    ghostLaw h (ghostAvoids K ∩ C) = ghostW h ^ K.card * ghostLaw h C := by
  classical
  have hfun : (ghostAvoids (V := V) K ∩ C).indicator (fun _ => (1 : ℝ≥0∞))
      = fun G => ghostAvoidInd K G * C.indicator (fun _ => (1 : ℝ≥0∞)) G := by
    funext G
    by_cases h1 : G ∈ ghostAvoids K <;> by_cases h2 : G ∈ C <;>
      simp [ghostAvoidInd, h1, h2]
  have hCinv : ∀ G G' : V → Prop, (∀ v, v ∉ (K : Set V) → (G' v ↔ G v)) →
      C.indicator (fun _ => (1 : ℝ≥0∞)) G' = C.indicator (fun _ => (1 : ℝ≥0∞)) G := by
    intro G G' hag
    by_cases hG : G ∈ C
    · rw [Set.indicator_of_mem hG, Set.indicator_of_mem (hinv G G' hag hG)]
    · rw [Set.indicator_of_notMem hG,
        Set.indicator_of_notMem (fun hh => hG (by
          have := hinv G' G (fun v hv => (hag v hv).symm) hh; exact this))]
  have hmeas : Measurable (C.indicator (fun _ => (1 : ℝ≥0∞))) :=
    Measurable.indicator measurable_const hC
  have h1 : ∫⁻ G, (ghostAvoids (V := V) K ∩ C).indicator (fun _ => (1 : ℝ≥0∞)) G
        ∂(ghostLaw h) = (ghostLaw h) (ghostAvoids K ∩ C) := by
    rw [lintegral_indicator ((measurableSet_ghostAvoids K).inter hC), setLIntegral_one]
  have h2 : ∫⁻ G, C.indicator (fun _ => (1 : ℝ≥0∞)) G ∂(ghostLaw h) = (ghostLaw h) C := by
    rw [lintegral_indicator hC, setLIntegral_one]
  rw [← h1, hfun, lintegral_ghostAvoid_mul h K hmeas hCinv, h2]

end PercLib.CriticalLRP
