namespace PercLib.CriticalLRP.MomentProblem

/-! ### Monomial algebras generated by a family of test functions -/

section General

variable {Y : Type*} [TopologicalSpace Y] [CompactSpace Y] [T2Space Y]
variable {T : Type*} (Φ : T → C(Y, ℝ))

/-- The monomial functional `y ↦ ∏ i, Φ (f i) y` in the generators `Φ`. -/
noncomputable def monomial {ι : Type*} [Fintype ι] (f : ι → T) : C(Y, ℝ) :=
  ∏ i, Φ (f i)

lemma monomial_apply {ι : Type*} [Fintype ι] (f : ι → T) (y : Y) :
    monomial Φ f y = ∏ i, Φ (f i) y := by
  simp [monomial]

/-- The empty monomial is the constant function `1`. -/
lemma monomial_empty :
    monomial Φ (fun i : Fin 0 => (i.elim0 : T)) = 1 := by
  ext y
  simp [monomial]

/-- A product of two monomials is a monomial. -/
lemma monomial_mul {n m : ℕ} (f : Fin n → T) (g : Fin m → T) :
    monomial Φ f * monomial Φ g = monomial Φ (Fin.append f g) := by
  ext y
  simp only [monomial_apply, ContinuousMap.mul_apply, Fin.prod_univ_add, Fin.append_left,
    Fin.append_right]

/-- A continuous function is a monomial function if it is a scalar multiple of a monomial. -/
def IsMonomial (g : C(Y, ℝ)) : Prop :=
  ∃ (n : ℕ) (f : Fin n → T) (c : ℝ), g = c • monomial Φ f

/-- The linear span of the monomial functions. -/
noncomputable def monomialSpan : Submodule ℝ C(Y, ℝ) :=
  Submodule.span ℝ {g | IsMonomial Φ g}

lemma isMonomial_mul {a b : C(Y, ℝ)} (ha : IsMonomial Φ a) (hb : IsMonomial Φ b) :
    IsMonomial Φ (a * b) := by
  obtain ⟨n, f, c, rfl⟩ := ha
  obtain ⟨m, g, d, rfl⟩ := hb
  refine ⟨n + m, Fin.append f g, c * d, ?_⟩
  rw [smul_mul_smul, monomial_mul]

lemma mul_mem_monomialSpan {a b : C(Y, ℝ)}
    (ha : a ∈ monomialSpan Φ) (hb : b ∈ monomialSpan Φ) : a * b ∈ monomialSpan Φ := by
  refine Submodule.span_induction (p := fun x _ => x * b ∈ monomialSpan Φ) ?_ ?_ ?_ ?_ ha
  · intro x hx
    refine Submodule.span_induction (p := fun y _ => x * y ∈ monomialSpan Φ) ?_ ?_ ?_ ?_ hb
    · intro y hy
      exact Submodule.subset_span (isMonomial_mul Φ hx hy)
    · simp
    · intro y z _ _ hy hz
      rw [mul_add]
      exact (monomialSpan Φ).add_mem hy hz
    · intro r y _ hy
      rw [mul_smul_comm]
      exact (monomialSpan Φ).smul_mem r hy
  · simp
  · intro x y _ _ hx hy
    rw [add_mul]
    exact (monomialSpan Φ).add_mem hx hy
  · intro r x _ hx
    rw [smul_mul_assoc]
    exact (monomialSpan Φ).smul_mem r hx

/-- The algebra generated by the monomial functions. -/
noncomputable def monomialAlgebra : Subalgebra ℝ C(Y, ℝ) where
  carrier := monomialSpan Φ
  mul_mem' := mul_mem_monomialSpan Φ
  add_mem' := (monomialSpan Φ).add_mem
  algebraMap_mem' := by
    intro r
    have h1 : algebraMap ℝ C(Y, ℝ) r = r • monomial Φ (fun i : Fin 0 => (i.elim0 : T)) := by
      simp [monomial_empty, Algebra.algebraMap_eq_smul_one]
    rw [h1]
    exact Submodule.subset_span (show IsMonomial Φ
      (r • monomial Φ (fun i : Fin 0 => (i.elim0 : T))) from
      ⟨0, fun i => (i.elim0 : T), r, rfl⟩)

lemma monomial_mem_monomialAlgebra {n : ℕ} (f : Fin n → T) :
    monomial Φ f ∈ monomialAlgebra Φ := by
  refine Submodule.subset_span (show IsMonomial Φ (monomial Φ f) from ⟨n, f, 1, by simp⟩)

/-- If the generators separate points of `Y`, then the monomial algebra separates points. -/
theorem monomialAlgebra_separatesPoints
    (hΦ : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ t : T, Φ t y₁ ≠ Φ t y₂) :
    (monomialAlgebra Φ).SeparatesPoints := by
  intro y₁ y₂ hne
  obtain ⟨t, ht⟩ := hΦ y₁ y₂ hne
  refine ⟨monomial Φ (fun _ : Fin 1 => t), ?_, ?_⟩
  · exact ⟨monomial Φ (fun _ : Fin 1 => t),
      monomial_mem_monomialAlgebra Φ _, rfl⟩
  · simpa [monomial_apply, Fin.prod_univ_one] using ht

/-- **Stone--Weierstrass**: the monomial algebra is dense in all continuous functions on `Y`. -/
theorem monomialAlgebra_topologicalClosure
    (hΦ : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ t : T, Φ t y₁ ≠ Φ t y₂) :
    (monomialAlgebra Φ).topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints _
    (monomialAlgebra_separatesPoints Φ hΦ)

end General

/-! ### Moment determinacy and convergence -/

section Laws

variable {Y : Type*} [TopologicalSpace Y] [CompactSpace Y] [T2Space Y]
variable {T : Type*} (Φ : T → C(Y, ℝ))
variable [MeasurableSpace Y] [OpensMeasurableSpace Y]

/-- A continuous function is integrable against any finite measure on a compact space. -/
lemma integrable_continuousMap (ν : Measure Y) [IsFiniteMeasure ν] (a : C(Y, ℝ)) :
    Integrable (fun y => a y) ν :=
  Integrable.of_bound a.continuous.aestronglyMeasurable ‖a‖
    (ae_of_all _ fun y => a.norm_coe_le_norm y)

variable {ν₁ ν₂ : Measure Y} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]

/-- Two measures on `Y` have the same moments if all integrals against monomials agree. -/
def HasSameMoments (Φ : T → C(Y, ℝ)) (ν₁ ν₂ : Measure Y) : Prop :=
  ∀ (n : ℕ) (f : Fin n → T), ∫ y, monomial Φ f y ∂ν₁ = ∫ y, monomial Φ f y ∂ν₂

/-- Integrals of monomial functions are determined by the monomial integrals, by linearity. -/
lemma integral_eq_of_hasSameMoments (h : HasSameMoments Φ ν₁ ν₂)
    {a : C(Y, ℝ)} (ha : a ∈ monomialAlgebra Φ) :
    ∫ y, a y ∂ν₁ = ∫ y, a y ∂ν₂ := by
  refine Submodule.span_induction (p := fun x _ => ∫ y, x y ∂ν₁ = ∫ y, x y ∂ν₂) ?_ ?_ ?_ ?_ ha
  · intro x hx
    obtain ⟨n, f, c, rfl⟩ := hx
    simp only [ContinuousMap.smul_apply, smul_eq_mul]
    rw [integral_const_mul, integral_const_mul, h n f]
  · simp
  · intro x z _ _ hx hz
    have hX : ∫ y, (x + z) y ∂ν₁ = ∫ y, x y ∂ν₁ + ∫ y, z y ∂ν₁ := by
      simp only [ContinuousMap.add_apply]
      exact integral_add (integrable_continuousMap ν₁ x) (integrable_continuousMap ν₁ z)
    have hY : ∫ y, (x + z) y ∂ν₂ = ∫ y, x y ∂ν₂ + ∫ y, z y ∂ν₂ := by
      simp only [ContinuousMap.add_apply]
      exact integral_add (integrable_continuousMap ν₂ x) (integrable_continuousMap ν₂ z)
    rw [hX, hY, hx, hz]
  · intro r x _ hx
    simp only [ContinuousMap.smul_apply, smul_eq_mul]
    rw [integral_const_mul, integral_const_mul, hx]

/-- Uniform approximation by elements of the monomial algebra transfers integral equalities. -/
theorem integral_eq_of_hasSameMoments_continuousMap
    (hΦ : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ t : T, Φ t y₁ ≠ Φ t y₂)
    (h : HasSameMoments Φ ν₁ ν₂) (g : C(Y, ℝ)) : ∫ y, g y ∂ν₁ = ∫ y, g y ∂ν₂ := by
  set C : ℝ := ν₁.real Set.univ + ν₂.real Set.univ with hC
  have hC0 : 0 ≤ C := by positivity
  have key : ∀ ε : ℝ, 0 < ε → ‖∫ y, g y ∂ν₁ - ∫ y, g y ∂ν₂‖ ≤ ε := by
    intro ε hε
    set δ : ℝ := ε / (2 * (C + 1)) with hδ
    have hδ0 : 0 < δ := by positivity
    have hsep : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ t : T, Φ t y₁ ≠ Φ t y₂ := hΦ
    obtain ⟨a, ha⟩ := ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
      (monomialAlgebra Φ) (monomialAlgebra_separatesPoints Φ hsep) g δ hδ0
    have hnorm : ‖(a : C(Y, ℝ)) - g‖ < δ := ha
    have heq : ∫ y, (a : C(Y, ℝ)) y ∂ν₁ = ∫ y, (a : C(Y, ℝ)) y ∂ν₂ :=
      integral_eq_of_hasSameMoments Φ h a.2
    have hb1 : ‖∫ y, g y ∂ν₁ - ∫ y, (a : C(Y, ℝ)) y ∂ν₁‖
        ≤ ‖g - (a : C(Y, ℝ))‖ * ν₁.real Set.univ := by
      rw [← integral_sub (integrable_continuousMap ν₁ g) (integrable_continuousMap ν₁ a)]
      exact norm_integral_le_of_norm_le_const (ae_of_all _ fun y => by
        simpa using ContinuousMap.norm_coe_le_norm (g - (a : C(Y, ℝ))) y)
    have hb2 : ‖∫ y, (a : C(Y, ℝ)) y ∂ν₂ - ∫ y, g y ∂ν₂‖
        ≤ ‖(a : C(Y, ℝ)) - g‖ * ν₂.real Set.univ := by
      rw [← integral_sub (integrable_continuousMap ν₂ a) (integrable_continuousMap ν₂ g)]
      exact norm_integral_le_of_norm_le_const (ae_of_all _ fun y => by
        simpa using ContinuousMap.norm_coe_le_norm ((a : C(Y, ℝ)) - g) y)
    have hga : ‖g - (a : C(Y, ℝ))‖ < δ := by
      rw [← norm_neg, neg_sub]
      exact hnorm
    have hle1 : ‖g - (a : C(Y, ℝ))‖ ≤ δ := le_of_lt hga
    have hle2 : ‖(a : C(Y, ℝ)) - g‖ ≤ δ := by
      rw [← norm_neg, neg_sub]
      exact hle1
    calc ‖∫ y, g y ∂ν₁ - ∫ y, g y ∂ν₂‖
        = ‖(∫ y, g y ∂ν₁ - ∫ y, (a : C(Y, ℝ)) y ∂ν₁)
            + (∫ y, (a : C(Y, ℝ)) y ∂ν₂ - ∫ y, g y ∂ν₂)‖ := by
          rw [heq]; ring_nf
      _ ≤ ‖∫ y, g y ∂ν₁ - ∫ y, (a : C(Y, ℝ)) y ∂ν₁‖
            + ‖∫ y, (a : C(Y, ℝ)) y ∂ν₂ - ∫ y, g y ∂ν₂‖ := norm_add_le _ _
      _ ≤ ‖g - (a : C(Y, ℝ))‖ * ν₁.real Set.univ
            + ‖(a : C(Y, ℝ)) - g‖ * ν₂.real Set.univ := add_le_add hb1 hb2
      _ ≤ δ * C := by
          have h1 : ‖g - (a : C(Y, ℝ))‖ * ν₁.real Set.univ ≤ δ * ν₁.real Set.univ :=
            mul_le_mul_of_nonneg_right hle1 (by positivity)
          have h2 : ‖(a : C(Y, ℝ)) - g‖ * ν₂.real Set.univ ≤ δ * ν₂.real Set.univ :=
            mul_le_mul_of_nonneg_right hle2 (by positivity)
          nlinarith [hC]
      _ = ε * (C / (2 * (C + 1))) := by rw [hδ]; ring
      _ ≤ ε := by
          have : C / (2 * (C + 1)) ≤ 1 := by
            rw [div_le_one (by positivity)]; linarith
          nlinarith [hε.le]
  have hzero : ‖∫ y, g y ∂ν₁ - ∫ y, g y ∂ν₂‖ ≤ 0 := by
    refine le_of_forall_pos_le_add ?_
    intro ε hε
    simpa using key ε hε
  have hz : ∫ y, g y ∂ν₁ - ∫ y, g y ∂ν₂ = 0 :=
    norm_eq_zero.mp (le_antisymm hzero (norm_nonneg _))
  linarith

/-- **Moment determinacy.** Two finite measures on a compact space with the same moments
coincide. -/
theorem ext_of_forall_moment_integral_eq [BorelSpace Y] [HasOuterApproxClosed Y]
    (hΦ : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ t : T, Φ t y₁ ≠ Φ t y₂)
    (h : HasSameMoments Φ ν₁ ν₂) : ν₁ = ν₂ := by
  refine ext_of_forall_integral_eq_of_IsFiniteMeasure (Ω := Y) ?_
  intro f
  have h' := integral_eq_of_hasSameMoments_continuousMap Φ hΦ h
    (⟨f, f.continuous⟩ : C(Y, ℝ))
  simpa using h'

/-- The difference of the integrals against two continuous functions is bounded by their sup
distance, for a probability measure. -/
lemma abs_integral_sub_le_norm (ν : Measure Y) [IsProbabilityMeasure ν] (f g : C(Y, ℝ)) :
    |∫ y, f y ∂ν - ∫ y, g y ∂ν| ≤ ‖f - g‖ := by
  rw [← integral_sub (integrable_continuousMap ν f) (integrable_continuousMap ν g),
    ← Real.norm_eq_abs]
  have hb : ‖∫ y, (f - g) y ∂ν‖ ≤ ‖f - g‖ * ν.real Set.univ :=
    norm_integral_le_of_norm_le_const (ae_of_all _ fun y => by
      simpa using ContinuousMap.norm_coe_le_norm (f - g) y)
  have huniv : ν.real Set.univ = 1 := by
    rw [Measure.real_def, measure_univ, ENNReal.toReal_one]
  rwa [huniv, mul_one] at hb

variable {ν : ℕ → ProbabilityMeasure Y} {νlim : ProbabilityMeasure Y}

/-- Convergence of all moments implies convergence of the integrals of every monomial function. -/
lemma tendsto_integral_of_mem_monomialAlgebra
    (h : ∀ (n : ℕ) (f : Fin n → T),
      Tendsto (fun k => ∫ y, monomial Φ f y ∂(ν k : Measure Y)) atTop
        (𝓝 (∫ y, monomial Φ f y ∂(νlim : Measure Y))))
    {a : C(Y, ℝ)} (ha : a ∈ monomialAlgebra Φ) :
    Tendsto (fun k => ∫ y, a y ∂(ν k : Measure Y)) atTop
      (𝓝 (∫ y, a y ∂(νlim : Measure Y))) := by
  refine Submodule.span_induction (p := fun x _ => Tendsto
    (fun k => ∫ y, x y ∂(ν k : Measure Y)) atTop
    (𝓝 (∫ y, x y ∂(νlim : Measure Y)))) ?_ ?_ ?_ ?_ ha
  · intro x hx
    obtain ⟨n, f, c, rfl⟩ := hx
    have hfun : (fun k => ∫ y, (c • monomial Φ f) y ∂(ν k : Measure Y))
        = fun k => c * ∫ y, monomial Φ f y ∂(ν k : Measure Y) :=
      funext fun k => by
        simp only [ContinuousMap.smul_apply, smul_eq_mul, integral_const_mul]
    have hlim : ∫ y, (c • monomial Φ f) y ∂(νlim : Measure Y)
        = c * ∫ y, monomial Φ f y ∂(νlim : Measure Y) := by
      simp only [ContinuousMap.smul_apply, smul_eq_mul, integral_const_mul]
    rw [hfun, hlim]
    exact (h n f).const_mul c
  · simpa using tendsto_const_nhds
  · intro x z _ _ hx hz
    have hfun : ∀ k, ∫ y, (x + z) y ∂(ν k : Measure Y)
        = ∫ y, x y ∂(ν k : Measure Y) + ∫ y, z y ∂(ν k : Measure Y) := fun k => by
      simp only [ContinuousMap.add_apply]
      exact integral_add (integrable_continuousMap _ x) (integrable_continuousMap _ z)
    have hlim : ∫ y, (x + z) y ∂(νlim : Measure Y)
        = ∫ y, x y ∂(νlim : Measure Y) + ∫ y, z y ∂(νlim : Measure Y) := by
      simp only [ContinuousMap.add_apply]
      exact integral_add (integrable_continuousMap _ x) (integrable_continuousMap _ z)
    simp only [hfun, hlim]
    exact hx.add hz
  · intro r x _ hx
    have hfun : (fun k => ∫ y, (r • x) y ∂(ν k : Measure Y))
        = fun k => r * ∫ y, x y ∂(ν k : Measure Y) :=
      funext fun k => by
        simp only [ContinuousMap.smul_apply, smul_eq_mul, integral_const_mul]
    have hlim : ∫ y, (r • x) y ∂(νlim : Measure Y)
        = r * ∫ y, x y ∂(νlim : Measure Y) := by
      simp only [ContinuousMap.smul_apply, smul_eq_mul, integral_const_mul]
    rw [hfun, hlim]
    exact hx.const_mul r

/-- **Weak convergence from moment convergence.** If all monomial moment functionals converge, then
the probability measures converge weakly. -/
theorem tendsto_of_forall_moment_tendsto
    (hΦ : ∀ y₁ y₂ : Y, y₁ ≠ y₂ → ∃ t : T, Φ t y₁ ≠ Φ t y₂)
    (h : ∀ (n : ℕ) (f : Fin n → T),
      Tendsto (fun k => ∫ y, monomial Φ f y ∂(ν k : Measure Y)) atTop
        (𝓝 (∫ y, monomial Φ f y ∂(νlim : Measure Y)))) :
    Tendsto ν atTop (𝓝 νlim) := by
  rw [ProbabilityMeasure.tendsto_iff_forall_integral_tendsto]
  intro g
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨a, ha⟩ := ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    (monomialAlgebra Φ) (monomialAlgebra_separatesPoints Φ hΦ)
    (⟨g, g.continuous⟩ : C(Y, ℝ)) (ε / 3) (by positivity)
  have hconv := tendsto_integral_of_mem_monomialAlgebra Φ h a.2
  rw [Metric.tendsto_atTop] at hconv
  obtain ⟨K, hK⟩ := hconv (ε / 3) (by positivity)
  refine ⟨K, fun k hk => ?_⟩
  have hae : ‖(a : C(Y, ℝ)) - ⟨g, g.continuous⟩‖ < ε / 3 := ha
  have hga : ‖(⟨g, g.continuous⟩ : C(Y, ℝ)) - a‖ < ε / 3 := by
    rw [← norm_neg, neg_sub]
    exact hae
  have h1 : |∫ y, g y ∂(ν k : Measure Y) - ∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y)|
      ≤ ‖(⟨g, g.continuous⟩ : C(Y, ℝ)) - a‖ :=
    abs_integral_sub_le_norm _ _ _
  have h2 : |∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y)
      - ∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y)| ≤ ε / 3 := le_of_lt (hK k hk)
  have h3 : |∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y)
      - ∫ y, g y ∂(νlim : Measure Y)|
      ≤ ‖(a : C(Y, ℝ)) - (⟨g, g.continuous⟩ : C(Y, ℝ))‖ :=
    abs_integral_sub_le_norm _ _ _
  have h3' : ‖(a : C(Y, ℝ)) - (⟨g, g.continuous⟩ : C(Y, ℝ))‖ ≤ ε / 3 := le_of_lt hae
  rw [dist_eq_norm]
  have hsplit : ∫ y, g y ∂(ν k : Measure Y) - ∫ y, g y ∂(νlim : Measure Y)
      = (∫ y, g y ∂(ν k : Measure Y) - ∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y))
        + ((∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y)
          - ∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y)))
        + (∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y) - ∫ y, g y ∂(νlim : Measure Y)) := by
    ring
  rw [hsplit]
  have hb : ‖(a : C(Y, ℝ)) - (⟨g, g.continuous⟩ : C(Y, ℝ))‖
      = ‖(⟨g, g.continuous⟩ : C(Y, ℝ)) - a‖ := by
    rw [← norm_neg, neg_sub]
  calc ‖(∫ y, g y ∂(ν k : Measure Y) - ∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y))
        + ((∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y)
          - ∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y)))
        + (∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y) - ∫ y, g y ∂(νlim : Measure Y))‖
      ≤ ‖(∫ y, g y ∂(ν k : Measure Y) - ∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y))
        + ((∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y)
          - ∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y)))‖
        + ‖(∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y) - ∫ y, g y ∂(νlim : Measure Y))‖ :=
        norm_add_le _ _
    _ ≤ (‖(∫ y, g y ∂(ν k : Measure Y) - ∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y))‖
        + ‖((∫ y, (a : C(Y, ℝ)) y ∂(ν k : Measure Y)
          - ∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y)))‖)
        + ‖(∫ y, (a : C(Y, ℝ)) y ∂(νlim : Measure Y) - ∫ y, g y ∂(νlim : Measure Y))‖ := by
        gcongr
        exact norm_add_le _ _
    _ < ε / 3 + ε / 3 + ε / 3 := by
        rw [← Real.norm_eq_abs] at h1 h2 h3
        linarith [h1, h2, h3, hga, h3']
    _ = ε := by ring

end Laws

/-! ### Application: laws of random probability measures

Here `Y = ProbabilityMeasure X` and the test functions are the integration functionals
`μ ↦ ∫ x, g x ∂μ`, so that the monomials of the general theory are exactly the moment
functionals `μ ↦ ∏ i, ∫ x, f i x ∂μ` of the random measure `μ`. -/

section RandomMeasure

variable {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X]
  [PseudoMetrizableSpace X] [MeasurableSpace X] [BorelSpace X]

/-- The integration functional `μ ↦ ∫ x, g x ∂μ` on the space of probability measures. -/
noncomputable def integralFun (g : C(X, ℝ)) : C(ProbabilityMeasure X, ℝ) :=
  ⟨fun μ => ∫ x, g x ∂μ, ProbabilityMeasure.continuous_integral_continuousMap g⟩

@[simp]
lemma integralFun_apply (g : C(X, ℝ)) (μ : ProbabilityMeasure X) :
    integralFun g μ = ∫ x, g x ∂μ := rfl

/-- Distinct probability measures are separated by the integral against some continuous function. -/
theorem integralFun_separates (μ₁ μ₂ : ProbabilityMeasure X) (hne : μ₁ ≠ μ₂) :
    ∃ g : C(X, ℝ), integralFun g μ₁ ≠ integralFun g μ₂ := by
  have hex : ∃ f : X →ᵇ ℝ,
      ∫ x, f x ∂(μ₁ : Measure X) ≠ ∫ x, f x ∂(μ₂ : Measure X) := by
    by_contra h
    simp only [not_exists, ne_eq, not_not] at h
    have h1 : IsFiniteMeasure (μ₁ : Measure X) := inferInstance
    have h2 : IsFiniteMeasure (μ₂ : Measure X) := inferInstance
    have h3 : (μ₁ : Measure X) = (μ₂ : Measure X) :=
      ext_of_forall_integral_eq_of_IsFiniteMeasure h
    exact hne (Subtype.ext h3)
  obtain ⟨f, hf⟩ := hex
  exact ⟨⟨f, f.continuous⟩, hf⟩

namespace RandomMeasure

/-- Two finite measures on `ProbabilityMeasure X` with the same moments coincide. -/
theorem ext_of_forall_moment_integral_eq
    [MeasurableSpace (ProbabilityMeasure X)] [OpensMeasurableSpace (ProbabilityMeasure X)]
    [BorelSpace (ProbabilityMeasure X)] [HasOuterApproxClosed (ProbabilityMeasure X)]
    {ν₁ ν₂ : Measure (ProbabilityMeasure X)} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : HasSameMoments (integralFun (X := X)) ν₁ ν₂) : ν₁ = ν₂ :=
  MomentProblem.ext_of_forall_moment_integral_eq (T := C(X, ℝ)) (Φ := integralFun) integralFun_separates h

/-- Convergence in law from convergence of all moments. -/
theorem tendsto_of_forall_moment_tendsto
    [MeasurableSpace (ProbabilityMeasure X)] [OpensMeasurableSpace (ProbabilityMeasure X)]
    {ν : ℕ → ProbabilityMeasure (ProbabilityMeasure X)}
    {νlim : ProbabilityMeasure (ProbabilityMeasure X)}
    (h : ∀ (n : ℕ) (f : Fin n → C(X, ℝ)),
      Tendsto (fun k => ∫ μ, monomial (integralFun (X := X)) f μ
          ∂(ν k : Measure (ProbabilityMeasure X))) atTop
        (𝓝 (∫ μ, monomial (integralFun (X := X)) f μ
          ∂(νlim : Measure (ProbabilityMeasure X))))) :
    Tendsto ν atTop (𝓝 νlim) :=
  MomentProblem.tendsto_of_forall_moment_tendsto (Φ := integralFun (X := X))
    integralFun_separates h

/-- If a subalgebra `A ⊆ C(X, ℝ)` separates points, then the integration functionals of elements
of `A` separate probability measures. -/
theorem integralFun_separates_of_separatesPoints (A : Subalgebra ℝ C(X, ℝ))
    (hA : A.SeparatesPoints) (μ₁ μ₂ : ProbabilityMeasure X) (hne : μ₁ ≠ μ₂) :
    ∃ a : A, integralFun (a : C(X, ℝ)) μ₁ ≠ integralFun (a : C(X, ℝ)) μ₂ := by
  obtain ⟨g, hg⟩ := integralFun_separates μ₁ μ₂ hne
  have hpos : 0 < |integralFun g μ₁ - integralFun g μ₂| := by
    rw [abs_pos]; exact sub_ne_zero.mpr hg
  obtain ⟨a, ha⟩ := ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    A hA g (|integralFun g μ₁ - integralFun g μ₂| / 2) (by positivity)
  refine ⟨⟨a, a.2⟩, ?_⟩
  have ha' : ‖(a : C(X, ℝ)) - g‖ < |integralFun g μ₁ - integralFun g μ₂| / 2 := ha
  have h1 : |integralFun a μ₁ - integralFun g μ₁|
      ≤ ‖(a : C(X, ℝ)) - g‖ := abs_integral_sub_le_norm (ν := (μ₁ : Measure X)) a g
  have h2 : |integralFun a μ₂ - integralFun g μ₂|
      ≤ ‖(a : C(X, ℝ)) - g‖ := abs_integral_sub_le_norm (ν := (μ₂ : Measure X)) a g
  intro hcontra
  have hzero : integralFun a μ₁ = integralFun a μ₂ := hcontra
  have h3 : |integralFun g μ₁ - integralFun g μ₂|
      ≤ |integralFun a μ₁ - integralFun g μ₁| + |integralFun a μ₂ - integralFun g μ₂| := by
    have : integralFun g μ₁ - integralFun g μ₂
        = -((integralFun a μ₁ - integralFun g μ₁)) + (integralFun a μ₂ - integralFun g μ₂) := by
      rw [hzero]; ring
    calc |integralFun g μ₁ - integralFun g μ₂|
        = |-(integralFun a μ₁ - integralFun g μ₁) + (integralFun a μ₂ - integralFun g μ₂)| := by
          rw [this]
      _ ≤ |-(integralFun a μ₁ - integralFun g μ₁)| + |integralFun a μ₂ - integralFun g μ₂| :=
          abs_add_le _ _
      _ = |integralFun a μ₁ - integralFun g μ₁| + |integralFun a μ₂ - integralFun g μ₂| := by
          rw [abs_neg]
  linarith

/-- It suffices to test the moments against a separating subalgebra of continuous functions,
e.g. the polynomial functions on a compact set. -/
theorem ext_of_forall_moment_integral_eq_of_separatesPoints
    [MeasurableSpace (ProbabilityMeasure X)] [OpensMeasurableSpace (ProbabilityMeasure X)]
    [BorelSpace (ProbabilityMeasure X)] [HasOuterApproxClosed (ProbabilityMeasure X)]
    (A : Subalgebra ℝ C(X, ℝ)) (hA : A.SeparatesPoints)
    {ν₁ ν₂ : Measure (ProbabilityMeasure X)} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : HasSameMoments (Φ := fun a : A => integralFun (a : C(X, ℝ))) ν₁ ν₂) : ν₁ = ν₂ :=
  MomentProblem.ext_of_forall_moment_integral_eq
    (Φ := fun a : A => integralFun (a : C(X, ℝ)))
    (integralFun_separates_of_separatesPoints A hA) h

/-- Convergence in law from convergence of the moments of a separating subalgebra of test
functions. -/
theorem tendsto_of_forall_moment_tendsto_of_separatesPoints
    [MeasurableSpace (ProbabilityMeasure X)] [OpensMeasurableSpace (ProbabilityMeasure X)]
    (A : Subalgebra ℝ C(X, ℝ)) (hA : A.SeparatesPoints)
    {ν : ℕ → ProbabilityMeasure (ProbabilityMeasure X)}
    {νlim : ProbabilityMeasure (ProbabilityMeasure X)}
    (h : ∀ (n : ℕ) (f : Fin n → A),
      Tendsto (fun k => ∫ μ, monomial (fun a : A => integralFun (a : C(X, ℝ))) f μ
          ∂(ν k : Measure (ProbabilityMeasure X))) atTop
        (𝓝 (∫ μ, monomial (fun a : A => integralFun (a : C(X, ℝ))) f μ
          ∂(νlim : Measure (ProbabilityMeasure X))))) :
    Tendsto ν atTop (𝓝 νlim) :=
  MomentProblem.tendsto_of_forall_moment_tendsto
    (Φ := fun a : A => integralFun (a : C(X, ℝ)))
    (integralFun_separates_of_separatesPoints A hA) h

end RandomMeasure

end RandomMeasure

/-! ### Polynomial test functions on a compact subset of `ℝ^d` -/

section Polynomial

variable {d : ℕ} {K : Set (Fin d → ℝ)}

/-- The `i`-th coordinate function on a set `K ⊆ ℝ^d`. -/
noncomputable def coordFun (i : Fin d) : C(K, ℝ) :=
  ⟨fun x => (x : Fin d → ℝ) i, (continuous_apply i).comp continuous_subtype_val⟩

/-- The algebra of polynomial functions (in the coordinates) on `K`. -/
noncomputable def polyAlgebra (K : Set (Fin d → ℝ)) : Subalgebra ℝ C(K, ℝ) :=
  Algebra.adjoin ℝ (Set.range (coordFun (K := K)))

/-- The continuous function on `K` underlying a multivariate polynomial. -/
noncomputable def polyFun (K : Set (Fin d → ℝ)) (P : MvPolynomial (Fin d) ℝ) : C(K, ℝ) :=
  MvPolynomial.aeval (fun i => coordFun (K := K) i) P

/-- The polynomial function associated to `P` is evaluation of `P`: `polyFun K P x = P(x)`. -/
lemma polyFun_apply (K : Set (Fin d → ℝ)) (P : MvPolynomial (Fin d) ℝ) (x : K) :
    polyFun K P x = P.eval x := by
  rw [polyFun]
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, ContinuousMap.mul_apply, MvPolynomial.aeval_X, MvPolynomial.eval_X, hp]
    simp [coordFun]

/-- `polyAlgebra K` is exactly the set of polynomial functions on `K`. -/
theorem polyAlgebra_eq_range (K : Set (Fin d → ℝ)) :
    polyAlgebra K = Set.range (polyFun K) := by
  rw [polyAlgebra, ← MvPolynomial.aeval_range]
  rfl

lemma polyFun_mem_polyAlgebra (K : Set (Fin d → ℝ)) (P : MvPolynomial (Fin d) ℝ) :
    polyFun K P ∈ polyAlgebra K := by
  have h : (polyAlgebra K : Set C(K, ℝ)) = Set.range (polyFun K) := polyAlgebra_eq_range K
  have hmem : polyFun K P ∈ (polyAlgebra K : Set C(K, ℝ)) := by
    rw [h]
    exact ⟨P, rfl⟩
  exact hmem

/-- Every element of `polyAlgebra K` is the polynomial function of some multivariate
polynomial. -/
lemma exists_polyFun_eq_of_mem_polyAlgebra (K : Set (Fin d → ℝ)) {g : C(K, ℝ)}
    (hg : g ∈ polyAlgebra K) : ∃ P : MvPolynomial (Fin d) ℝ, polyFun K P = g := by
  have h : (polyAlgebra K : Set C(K, ℝ)) = Set.range (polyFun K) := polyAlgebra_eq_range K
  have hg' : g ∈ (polyAlgebra K : Set C(K, ℝ)) := hg
  rw [h] at hg'
  exact hg'

/-- Polynomial functions separate points of any subset of `ℝ^d`. -/
theorem polyAlgebra_separatesPoints (K : Set (Fin d → ℝ)) :
    (polyAlgebra K).SeparatesPoints := by
  intro x y hxy
  have hne : (x : Fin d → ℝ) ≠ (y : Fin d → ℝ) := fun h => hxy (Subtype.ext h)
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hne
  have hmem : coordFun i ∈ polyAlgebra K :=
    Algebra.subset_adjoin (R := ℝ) (show coordFun i ∈ Set.range (coordFun (K := K)) from ⟨i, rfl⟩)
  exact ⟨coordFun i, ⟨coordFun i, hmem, rfl⟩, hi⟩

/-- **Polynomial moments determine the law.** For a random probability measure on a compact
`K ⊆ ℝ^d`, the laws of two such random measures coincide as soon as all polynomial moments
`∏ i, ∫ x, P_i(x) dμ` agree. This is the form of the moment hypothesis used in Theorem I.5.21 and
Corollary I.5.22 (there `P_1, …, P_n` are polynomials). -/
theorem ext_of_forall_polynomial_moment_eq
    [CompactSpace K] [T2Space K] [PseudoMetrizableSpace K] [MeasurableSpace K] [BorelSpace K]
    [MeasurableSpace (ProbabilityMeasure K)] [OpensMeasurableSpace (ProbabilityMeasure K)]
    [BorelSpace (ProbabilityMeasure K)] [HasOuterApproxClosed (ProbabilityMeasure K)]
    {ν₁ ν₂ : Measure (ProbabilityMeasure K)} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : ∀ (n : ℕ) (P : Fin n → MvPolynomial (Fin d) ℝ),
      ∫ μ, ∏ i, ∫ x, polyFun K (P i) x ∂(μ : Measure K) ∂ν₁
        = ∫ μ, ∏ i, ∫ x, polyFun K (P i) x ∂(μ : Measure K) ∂ν₂) :
    ν₁ = ν₂ := by
  refine RandomMeasure.ext_of_forall_moment_integral_eq_of_separatesPoints (polyAlgebra K)
    (polyAlgebra_separatesPoints K) ?_
  intro n f
  choose P hP using fun i => exists_polyFun_eq_of_mem_polyAlgebra K (f i).2
  have hgoal := h n P
  simp only [monomial_apply, integralFun_apply]
  simp_rw [← hP]
  exact hgoal

/-- **Convergence in law from polynomial moment convergence** for random probability measures on a
compact `K ⊆ ℝ^d`. -/
theorem tendsto_of_forall_polynomial_moment_tendsto
    [CompactSpace K] [T2Space K] [PseudoMetrizableSpace K] [MeasurableSpace K] [BorelSpace K]
    [MeasurableSpace (ProbabilityMeasure K)] [OpensMeasurableSpace (ProbabilityMeasure K)]
    {ν : ℕ → ProbabilityMeasure (ProbabilityMeasure K)}
    {νlim : ProbabilityMeasure (ProbabilityMeasure K)}
    (h : ∀ (n : ℕ) (P : Fin n → MvPolynomial (Fin d) ℝ),
      Tendsto (fun k => ∫ μ, ∏ i, ∫ x, polyFun K (P i) x ∂(μ : Measure K)
          ∂(ν k : Measure (ProbabilityMeasure K))) atTop
        (𝓝 (∫ μ, ∏ i, ∫ x, polyFun K (P i) x ∂(μ : Measure K)
          ∂(νlim : Measure (ProbabilityMeasure K))))) :
    Tendsto ν atTop (𝓝 νlim) := by
  refine RandomMeasure.tendsto_of_forall_moment_tendsto_of_separatesPoints (polyAlgebra K)
    (polyAlgebra_separatesPoints K) ?_
  intro n f
  choose P hP using fun i => exists_polyFun_eq_of_mem_polyAlgebra K (f i).2
  have hgoal := h n P
  simp only [monomial_apply, integralFun_apply]
  simp_rw [← hP]
  exact hgoal

end Polynomial

/-! ### The general schema: tightness + moment convergence + determinacy

The results above assume the carrier is compact. In the paper the random measures live on `ℝ^d`,
and compactness is replaced by tightness of the laws together with the fact that the limit law is
determined by its moments (Carleman's criterion). The schema below isolates exactly that
combination, for bounded continuous test functions (which is what the non-compact setting uses). -/

section Schema

variable {Y : Type*} [TopologicalSpace Y] [T2Space Y] [PseudoMetrizableSpace Y]
  [MeasurableSpace Y] [BorelSpace Y] [FirstCountableTopology (ProbabilityMeasure Y)]
variable {T : Type*} (Φ : T → Y →ᵇ ℝ)
variable {ν : ℕ → ProbabilityMeasure Y} {νlim : ProbabilityMeasure Y}

/-- The monomial `y ↦ ∏ i, Φ (f i) y` for bounded continuous generators. -/
noncomputable def bcMon {ι : Type*} [Fintype ι] (f : ι → T) : Y →ᵇ ℝ :=
  ∏ i, Φ (f i)

lemma bcMon_apply {ι : Type*} [Fintype ι] (f : ι → T) (y : Y) :
    bcMon Φ f y = ∏ i, Φ (f i) y := by
  simp [bcMon]

/-- **Tightness + moment convergence + moment determinacy ⇒ weak convergence.**

This is the logical form of the step from the moment asymptotics of Theorem I.5.21 to the scaling
limit of Corollary I.5.22, and of the corresponding step in Theorem I.1.9: the family of laws is
tight, all moments converge, and a probability measure is determined by its moments (in the paper,
via Carleman's criterion). The determinacy hypothesis is explicit here; on a compact carrier it is
discharged by `ext_of_forall_moment_integral_eq`. -/
theorem tendsto_of_tight_of_moment_tendsto
    (hdet : ∀ ν' : ProbabilityMeasure Y,
      (∀ (n : ℕ) (f : Fin n → T),
        ∫ y, bcMon Φ f y ∂(ν' : Measure Y) = ∫ y, bcMon Φ f y ∂(νlim : Measure Y)) →
      ν' = νlim)
    (htight : IsTightMeasureSet {μ : Measure Y | ∃ k, (ν k : Measure Y) = μ})
    (h : ∀ (n : ℕ) (f : Fin n → T),
      Tendsto (fun k => ∫ y, bcMon Φ f y ∂(ν k : Measure Y)) atTop
        (𝓝 (∫ y, bcMon Φ f y ∂(νlim : Measure Y)))) :
    Tendsto ν atTop (𝓝 νlim) := by
  have hS : IsCompact (closure (Set.range ν)) := by
    apply isCompact_closure_of_isTightMeasureSet
    convert htight using 2
    ext μ
    simp [eq_comm]
  apply tendsto_of_subseq_tendsto
  intro ns hns
  have hmem : ∀ k, ν (ns k) ∈ closure (Set.range ν) := fun k => subset_closure ⟨ns k, rfl⟩
  obtain ⟨ν', -, φ, hφ, hconv⟩ := hS.tendsto_subseq hmem
  have hmom : ∀ (n : ℕ) (f : Fin n → T),
      ∫ y, bcMon Φ f y ∂(ν' : Measure Y) = ∫ y, bcMon Φ f y ∂(νlim : Measure Y) := by
    intro n f
    have hcont : Tendsto (fun k => ∫ y, bcMon Φ f y ∂(ν (ns (φ k)) : Measure Y)) atTop
        (𝓝 (∫ y, bcMon Φ f y ∂(ν' : Measure Y))) := by
      have hc : Continuous fun μ : ProbabilityMeasure Y =>
          ∫ y, bcMon Φ f y ∂(μ : Measure Y) :=
        ProbabilityMeasure.continuous_integral_boundedContinuousFunction (bcMon Φ f)
      have := hc.tendsto ν'
      have h2 : Tendsto (fun k => ν (ns (φ k))) atTop (𝓝 ν') := hconv
      exact this.comp h2
    have halong : Tendsto (fun k => ∫ y, bcMon Φ f y ∂(ν (ns (φ k)) : Measure Y)) atTop
        (𝓝 (∫ y, bcMon Φ f y ∂(νlim : Measure Y))) := by
      have h2 : Tendsto (fun k => ns (φ k)) atTop atTop := hns.comp hφ.tendsto_atTop
      exact (h n f).comp h2
    exact tendsto_nhds_unique hcont halong
  refine ⟨φ, ?_⟩
  rw [hdet ν' hmom] at hconv
  exact hconv

end Schema

/-- Partial sums of the geometric series `∑_{n<N} e 2^{-(n+1)} = e - e 2^{-N}` in `ℝ≥0`,
stated without truncated subtraction. -/
lemma geom_partial_sum (e : ℝ≥0) (N : ℕ) :
    (∑ n ∈ Finset.range N, e * ((1 / 2 : ℝ≥0)) ^ (n + 1)) + e * ((1 / 2 : ℝ≥0)) ^ N = e := by
  apply NNReal.coe_injective
  push_cast
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, pow_succ]
    push_cast at ih ⊢
    linarith

/-- The diagonal geometric series of tail bounds sums to at most `e`. -/
lemma geom_tsum_le (e : ℝ≥0) :
    (∑' n : ℕ, ((e * ((1 / 2 : ℝ≥0)) ^ (n + 1) : ℝ≥0) : ℝ≥0∞)) ≤ e := by
  rw [ENNReal.tsum_eq_iSup_nat]
  refine iSup_le fun N => ?_
  rw [show (∑ a ∈ Finset.range N, ((e * ((1 / 2 : ℝ≥0)) ^ (a + 1) : ℝ≥0) : ℝ≥0∞))
      = ((∑ a ∈ Finset.range N, e * ((1 / 2 : ℝ≥0)) ^ (a + 1) : ℝ≥0) : ℝ≥0∞) by push_cast; rfl]
  have hle : (∑ a ∈ Finset.range N, e * ((1 / 2 : ℝ≥0)) ^ (a + 1)) ≤ e := by
    rw [← NNReal.coe_le_coe]
    have h := geom_partial_sum e N
    have h' : ((∑ a ∈ Finset.range N, e * ((1 / 2 : ℝ≥0)) ^ (a + 1) : ℝ≥0) : ℝ)
        + ((e * ((1 / 2 : ℝ≥0)) ^ N : ℝ≥0) : ℝ) = (e : ℝ) := by
      exact_mod_cast h
    have hb : (0 : ℝ) ≤ ((e * ((1 / 2 : ℝ≥0)) ^ N : ℝ≥0) : ℝ) := by positivity
    linarith
  exact_mod_cast hle

section Tightness

variable {Y : Type*} [TopologicalSpace Y] [T2Space Y] [NormalSpace Y]
  [MeasurableSpace Y] [BorelSpace Y]

/-- The value of a probability measure on a set, as an `ℝ≥0∞`, is the coercion of the `ℝ≥0`-valued
`FunLike` evaluation. -/
lemma probabilityMeasure_coe_apply (μ : ProbabilityMeasure Y) (s : Set Y) :
    ((μ s : ℝ≥0) : ℝ≥0∞) = (μ : Measure Y) s := by
  simp [ProbabilityMeasure.coeFn_def]

/-- **Tightness from uniform moment bounds.** If for every `ε > 0` there is a compact set `K ⊆ Y`
such that the expected mass that the random probability measure gives to `Kᶜ` is at most `ε²`
uniformly along the sequence, then the laws of the random measures are tight. -/
theorem isTightMeasureSet_of_uniform_lintegral_bound
    (ν : ℕ → ProbabilityMeasure (ProbabilityMeasure Y))
    (h : ∀ ε : ℝ≥0, 0 < ε → ∃ K : Set Y, IsCompact K ∧ ∀ k,
      ∫⁻ (μ : ProbabilityMeasure Y), (μ : Measure Y) Kᶜ ∂(ν k : Measure (ProbabilityMeasure Y))
        ≤ (ε : ℝ≥0∞) * (ε : ℝ≥0∞)) :
    IsTightMeasureSet {μ : Measure (ProbabilityMeasure Y) |
      ∃ k, (ν k : Measure (ProbabilityMeasure Y)) = μ} := by
  classical
  rw [isTightMeasureSet_iff_exists_isCompact_measure_compl_le]
  intro ε hε
  rcases eq_or_ne ε ⊤ with htop | htop
  · exact ⟨∅, isCompact_empty, fun μ _ => by rw [htop]; exact le_top⟩
  rw [← ENNReal.coe_toNNReal htop]
  set e : ℝ≥0 := ε.toNNReal with he
  have he0 : 0 < e := by
    rw [he]
    exact ENNReal.toNNReal_pos hε.ne' htop
  -- diagonal choice of compact sets
  choose K hK hKB using fun n : ℕ => h (e * (1 / 2 : ℝ≥0) ^ (n + 1)) (by positivity)
  have hu_tendsto : Tendsto (fun n : ℕ => e * (1 / 2 : ℝ≥0) ^ (n + 1)) atTop (𝓝 0) := by
    have h3 : Tendsto (fun n : ℕ => (1 / 2 : ℝ≥0) ^ n) atTop (𝓝 0) :=
      tendsto_pow_atTop_nhds_zero_of_lt_one (by positivity) (by norm_num)
    have h2 : Tendsto (fun n : ℕ => (1 / 2 : ℝ≥0) ^ (n + 1)) atTop (𝓝 0) :=
      h3.comp (tendsto_add_atTop_nat 1)
    simpa using h2.const_mul e
  have hcomp : IsCompact {μ : ProbabilityMeasure Y |
      ∀ n, μ (K n)ᶜ ≤ (e * (1 / 2 : ℝ≥0) ^ (n + 1))} :=
    isCompact_setOfPred_probabilityMeasure_mass_eq_compl_isCompact_le hu_tendsto hK
      (Or.inl inferInstance)
  refine ⟨{μ : ProbabilityMeasure Y |
      ∀ n, μ (K n)ᶜ ≤ (e * (1 / 2 : ℝ≥0) ^ (n + 1))}, hcomp, ?_⟩
  intro μ hμ
  obtain ⟨k, rfl⟩ := hμ
  have hsubset : {μ : ProbabilityMeasure Y |
        ∀ n, μ (K n)ᶜ ≤ (e * (1 / 2 : ℝ≥0) ^ (n + 1))}ᶜ
      ⊆ ⋃ n, {μ : ProbabilityMeasure Y |
          (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) < (μ : Measure Y) (K n)ᶜ} := by
    intro μ hμ
    simp only [Set.mem_compl_iff, Set.mem_ofPred_eq, not_forall] at hμ
    obtain ⟨n, hn⟩ := hμ
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq]
    refine ⟨n, ?_⟩
    have h1 : (e * (1 / 2 : ℝ≥0) ^ (n + 1)) < μ (K n)ᶜ := not_le.mp hn
    calc (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞)
        = ((e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0) : ℝ≥0∞) := rfl
      _ < ((μ (K n)ᶜ : ℝ≥0) : ℝ≥0∞) := by exact_mod_cast h1
      _ = (μ : Measure Y) (K n)ᶜ := probabilityMeasure_coe_apply μ _
  calc (ν k : Measure (ProbabilityMeasure Y))
        {μ : ProbabilityMeasure Y | ∀ n, μ (K n)ᶜ ≤ (e * (1 / 2 : ℝ≥0) ^ (n + 1))}ᶜ
      ≤ (ν k : Measure (ProbabilityMeasure Y)) (⋃ n,
          {μ : ProbabilityMeasure Y |
            (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) < (μ : Measure Y) (K n)ᶜ}) :=
        measure_mono hsubset
    _ ≤ ∑' n, (ν k : Measure (ProbabilityMeasure Y))
          {μ : ProbabilityMeasure Y |
            (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) < (μ : Measure Y) (K n)ᶜ} :=
        measure_iUnion_le _
    _ ≤ ∑' n, (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) := by
        refine ENNReal.tsum_le_tsum fun n => ?_
        -- Markov's inequality
        have hmeas : Measurable fun μ : ProbabilityMeasure Y => (μ : Measure Y) (K n)ᶜ :=
          (Measure.measurable_coe (hK n).isClosed.measurableSet.compl).comp measurable_subtype_coe
        have hmarkov := meas_ge_le_lintegral_div (μ := (ν k : Measure (ProbabilityMeasure Y)))
          (f := fun μ : ProbabilityMeasure Y => (μ : Measure Y) (K n)ᶜ) hmeas.aemeasurable
          (by positivity : (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) ≠ 0)
          (by finiteness : (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) ≠ ⊤)
        have hb := hKB n k
        calc (ν k : Measure (ProbabilityMeasure Y))
              {μ : ProbabilityMeasure Y |
                (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) < (μ : Measure Y) (K n)ᶜ}
            ≤ (ν k : Measure (ProbabilityMeasure Y))
              {μ : ProbabilityMeasure Y |
                (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) ≤ (μ : Measure Y) (K n)ᶜ} :=
              measure_mono (fun μ hμ => Set.mem_ofPred_eq.mpr (le_of_lt (Set.mem_ofPred_eq.mp hμ)))
          _ ≤ (∫⁻ (μ : ProbabilityMeasure Y), (μ : Measure Y) (K n)ᶜ
                ∂(ν k : Measure (ProbabilityMeasure Y)))
              / (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) := hmarkov
          _ ≤ (e * (1 / 2 : ℝ≥0) ^ (n + 1) : ℝ≥0∞) := by
              rw [ENNReal.div_le_iff (by positivity) (by finiteness)]
              exact hb
    _ ≤ (e : ℝ≥0∞) := geom_tsum_le e

end Tightness


end PercLib.CriticalLRP.MomentProblem
