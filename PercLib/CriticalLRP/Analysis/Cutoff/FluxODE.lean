/-!
# D1D: the standardized `p = 1` binomial pivotal flux and the source ODE rate

Ultramath swarm `smwttizjk`, member `m3`, direction D1D.  Candidate definitions and theorems
in the swarm's own directory; no production file is touched.

Source: Tom Hutchcroft, *Critical long-range percolation I: High effective dimension*,
arXiv:2508.18807v1, Lemma I.4.1 and displays (I.4.5)-(I.4.6), which write the infinite-volume
Russo derivative of the first moment of the cluster volume as

  `d/dr E_{b,r}|K|^p = b|J'(r)| sum_{x in K} sum_{y in B_r(x)} 1(y notin K)
      ((|K|+|K_y|)^p - |K|^p)`                                            (I.4.5)

The mean-field reduction of (I.4.5) to (I.4.6) has three layers, kept apart here:

* the `p = 1` binomial pivotal weight and its **mass transport** over the random cluster
  (`pf_flux.lean`), which turns the double sum into `E|K_0| sum_{y in B_r} 1(y notin K_0)|K_y|`;
* the **real algebra** of `E1Sign.pairMass`/`connMass`/`exclMass` with the source's defect
  `E_{1,r}`, which turns that expectation into `b|K'(r)| |B_r| chi^2 (1 - E_{1,r})`
  (`pf_ode.lean`, reusing `VolumeMoments.first_moment_ODE_of_pivot`);
* the **standardization error** `E_{0,r} = 1 - |K'(r)||B_r| r^{a+1}` and its limit, which is
  *discharged* here from the model's own `K_eq_integral`-free data `exists_error` and
  `SourceModelData.ball_count` (`pf_ode.lean`).

What is *not* proved here: the differentiation itself.  The derivative-to-flux identity
`F' r = b_c |K'(r)| (exclMass r).toReal` is carried as an explicit hypothesis of the assembled
ODE statements, and it is exactly the still-open infinite-volume Russo interchange (D1A).
-/

/-! ## Proofs: mass transport, defect identities, and conditional ODEs -/

@[expose] public section

namespace PercLib.CriticalLRP
namespace PivotFlux

open MeasureTheory Orchestration
open scoped ENNReal NNReal

variable (M : SourceModelData)

/-- The pivotal weight is covariant under lattice translations. -/
theorem pivotWeight_shift (r : ℝ) (t : M.V) (ω : Config M.V) (a b c : M.V) :
    pivotWeight M r (shiftConfig t ω) (a + t) (b + t) (c + t) = pivotWeight M r ω a b c := by
  simp only [pivotWeight, configIndicator_connects_shift t a b ω,
    configIndicator_not_connects_shift t b c ω, SourceModelData.clusterVol_shiftConfig]
  have hsub : (c + t) - (b + t) = c - b := by abel
  simp only [SourceNormData.dist, hsub]
  rfl

/-- The pivotal weight is measurable in the configuration. -/
theorem measurable_pivotWeight (r : ℝ) (a b c : M.V) :
    Measurable fun ω : Config M.V => pivotWeight M r ω a b c := by
  have h1 : Measurable fun ω : Config M.V =>
      configIndicator {ω' : Config M.V | Connects ω' a b} ω :=
    measurable_configIndicator (measurableSet_connects a b)
  have h2 : Measurable fun ω : Config M.V =>
      configIndicator {ω' : Config M.V | ¬ Connects ω' b c} ω :=
    measurable_configIndicator (measurableSet_connects b c).compl
  exact ((h1.mul measurable_const).mul h2).mul (measurable_clusterVol c)

/-! ### The pointwise reindexing -/

/-- At the root `b = 0` the pivotal weight factors into the anchor indicator and the
rooted ball summand. -/
theorem tsum_pivotWeight_eq (r : ℝ) (ω : Config M.V) (a : M.V) :
    (∑' c : M.V, pivotWeight M r ω a 0 c)
      = configIndicator {ω' : Config M.V | Connects ω' a (0 : M.V)} ω * ballSum M r ω := by
  have h : (∑' c : M.V, pivotWeight M r ω a 0 c)
      = ∑' c : M.V, configIndicator {ω' : Config M.V | Connects ω' a (0 : M.V)} ω *
          ((if M.S.ρ (toVec c) ≤ r then 1 else 0) *
            configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) c} ω *
              clusterVol ω c) :=
    tsum_congr fun c => by
      simp only [pivotWeight, SourceNormData.dist, sub_zero, mul_assoc]
  rw [h, ENNReal.tsum_mul_left]
  simp only [ballSum, mul_assoc]

/-- **The reindexed double sum is the excluded window moment's integrand.** -/
theorem tsum_tsum_pivotWeight_eq (r : ℝ) (ω : Config M.V) :
    (∑' a : M.V, ∑' c : M.V, pivotWeight M r ω a 0 c) = exclIntegrand M r ω := by
  rw [exclIntegrand]
  calc (∑' a : M.V, ∑' c : M.V, pivotWeight M r ω a 0 c)
      = ∑' a : M.V, configIndicator {ω' : Config M.V | Connects ω' a 0} ω * ballSum M r ω :=
        tsum_congr fun a => tsum_pivotWeight_eq M r ω a
    _ = (∑' a : M.V, configIndicator {ω' : Config M.V | Connects ω' a 0} ω) * ballSum M r ω :=
        ENNReal.tsum_mul_right
    _ = clusterVol ω (0 : M.V) * ballSum M r ω := by
        rw [tsum_connects_indicator]

/-! ### The interchange of `lintegral` with the flux sums -/

/-- The expectation of the paper's double sum is the double sum of expectations. -/
theorem lintegral_paperSum (μ : Measure (Config M.V)) (r : ℝ) :
    ∫⁻ ω, (∑' b : M.V, ∑' c : M.V, pivotWeight M r ω 0 b c) ∂μ
      = ∑' b : M.V, ∑' c : M.V, ∫⁻ ω, pivotWeight M r ω 0 b c ∂μ := by
  rw [lintegral_tsum]
  · refine tsum_congr fun b => ?_
    rw [lintegral_tsum]
    exact fun c => (measurable_pivotWeight M r 0 b c).aemeasurable
  · exact fun b => (Measurable.tsum fun c => measurable_pivotWeight M r 0 b c).aemeasurable

/-- The symmetric interchange for the root-anchored form. -/
theorem lintegral_reindexed (μ : Measure (Config M.V)) (r : ℝ) :
    ∫⁻ ω, (∑' a : M.V, ∑' c : M.V, pivotWeight M r ω a 0 c) ∂μ
      = ∑' a : M.V, ∑' c : M.V, ∫⁻ ω, pivotWeight M r ω a 0 c ∂μ := by
  rw [lintegral_tsum]
  · refine tsum_congr fun b => ?_
    rw [lintegral_tsum]
    exact fun c => (measurable_pivotWeight M r b 0 c).aemeasurable
  · exact fun b => (Measurable.tsum fun c => measurable_pivotWeight M r b 0 c).aemeasurable

/-! ### Mass transport -/

/-- Each edge weight is invariant in expectation under a simultaneous translation of the
anchor, the two endpoints and the configuration. -/
theorem integral_pivotWeight_shift (r : ℝ) (a b c t : M.V) :
    ∫⁻ ω, pivotWeight M r ω (a + t) (b + t) (c + t) ∂(M.cutLaw r)
      = ∫⁻ ω, pivotWeight M r ω a b c ∂(M.cutLaw r) := by
  calc ∫⁻ ω, pivotWeight M r ω (a + t) (b + t) (c + t) ∂(M.cutLaw r)
      = ∫⁻ ω, pivotWeight M r (shiftConfig (-t) ω) a b c ∂(M.cutLaw r) := by
        refine lintegral_congr fun ω => ?_
        simpa using (pivotWeight_shift M r (-t) ω (a + t) (b + t) (c + t)).symm
    _ = ∫⁻ ω, pivotWeight M r ω a b c ∂(M.cutLaw r).map (shiftConfig (-t)) := by
        rw [lintegral_map (measurable_pivotWeight M r a b c) (measurable_shiftConfig (-t))]
    _ = _ := by rw [M.cutLaw_map_shiftConfig r (-t)]

/-- **The mass-transport step of Lemma I.4.1 at the source model.** -/
theorem massTransport (r : ℝ) :
    (∑' b : M.V, ∑' c : M.V, ∫⁻ ω, pivotWeight M r ω 0 b c ∂(M.cutLaw r))
      = ∑' a : M.V, ∑' c : M.V, ∫⁻ ω, pivotWeight M r ω a 0 c ∂(M.cutLaw r) :=
  tsum_mass_transport₃ (fun a b c => ∫⁻ ω, pivotWeight M r ω a b c ∂(M.cutLaw r))
    (fun a b c t => integral_pivotWeight_shift M r a b c t)

/-! ### Identification with the excluded window moment -/

/-- The complement indicator in the form used by `E1Sign.exclMass`. -/
theorem configIndicator_not_connects_eq_compl_indicator (ω : Config M.V) (y : M.V) :
    configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) y} ω
      = ((cluster ω (0 : M.V))ᶜ).indicator (fun _ => (1 : ℝ≥0∞)) y := by
  by_cases h : y ∈ cluster ω (0 : M.V)
  · have hc : Connects ω (0 : M.V) y := mem_cluster_iff.mp h
    rw [configIndicator, Set.indicator_of_notMem (by simpa using hc),
      Set.indicator_of_notMem (by simpa using h)]
  · have hc : ¬ Connects ω (0 : M.V) y := fun hh => h (mem_cluster_iff.mpr hh)
    rw [configIndicator, Set.indicator_of_mem (by simpa using hc),
      Set.indicator_of_mem (by simpa using h)]

/-- The `tsum` form of the rooted ball sum is the finite `Finset` sum over `ballF`. -/
theorem ballSum_eq_finset (r : ℝ) (ω : Config M.V) :
    ballSum M r ω = ∑ y ∈ E1Sign.ballF M r,
      ((cluster ω (0 : M.V))ᶜ).indicator (fun _ => (1 : ℝ≥0∞)) y * clusterVol ω y := by
  unfold ballSum
  rw [tsum_eq_sum (s := E1Sign.ballF M r)]
  · refine Finset.sum_congr rfl fun y hy => ?_
    have hyb : M.S.ρ (toVec y) ≤ r := (E1Sign.mem_ballF M).mp hy
    rw [ite_eq_left hyb, one_mul, configIndicator_not_connects_eq_compl_indicator]
  · intro c hc
    have hgt : r < M.S.ρ (toVec c) := by
      by_contra hle
      exact hc ((E1Sign.mem_ballF M).mpr (not_lt.mp hle))
    rw [ite_eq_right (not_le.mpr hgt)]
    simp

/-- **Lemma I.4.1, mass-transport step, at the actual source model.**
The expectation of the paper's double sum `sum_{x in K} sum_{y in B_r(x)} 1(y notin K)|K_y|`
is the excluded window moment `E|K_0| sum_{y in B_r} 1(y notin K_0)|K_y|`.

This is the `p = 1` instance; it is *unconditional* in `ENNReal`: no finiteness of any
cutoff moment is used, and the truncated subtraction of `ENNReal` never appears because the
`p = 1` binomial increment is exactly `|K_y|`. -/
theorem lintegral_paperSum_eq_exclMass (r : ℝ) :
    ∫⁻ ω, paperSum M r ω ∂(M.cutLaw r) = E1Sign.exclMass M r := by
  unfold paperSum
  calc ∫⁻ ω, (∑' b : M.V, ∑' c : M.V, pivotWeight M r ω 0 b c) ∂(M.cutLaw r)
      = ∑' b : M.V, ∑' c : M.V, ∫⁻ ω, pivotWeight M r ω 0 b c ∂(M.cutLaw r) :=
        lintegral_paperSum M _ r
    _ = ∑' a : M.V, ∑' c : M.V, ∫⁻ ω, pivotWeight M r ω a 0 c ∂(M.cutLaw r) :=
        massTransport M r
    _ = ∫⁻ ω, (∑' a : M.V, ∑' c : M.V, pivotWeight M r ω a 0 c) ∂(M.cutLaw r) :=
        (lintegral_reindexed M _ r).symm
    _ = ∫⁻ ω, exclIntegrand M r ω ∂(M.cutLaw r) :=
        lintegral_congr fun ω => tsum_tsum_pivotWeight_eq M r ω
    _ = E1Sign.exclMass M r := by
        rw [E1Sign.exclMass]
        exact lintegral_congr fun ω => by rw [exclIntegrand, ballSum_eq_finset M r ω]

/-- **The `pairMass - connMass` form of (I.4.5).**  The expectation of the paper's double
sum is `S - T` with `S = pairMass.toReal`, `T = connMass.toReal`, i.e. the `p = 1` right-hand
side of (I.4.5) divided by the standardization factor `b_c|K'(r)|`. -/
theorem toReal_paperSum_eq_pairMass_sub_connMass (r : ℝ)
    (h2 : M.cutMoment 2 r ≠ ⊤) :
    (∫⁻ ω, paperSum M r ω ∂(M.cutLaw r)).toReal
      = (E1Sign.pairMass M r).toReal - (E1Sign.connMass M r).toReal := by
  rw [lintegral_paperSum_eq_exclMass, E1Sign.pairMass_eq M r]
  have hT : E1Sign.connMass M r ≠ ⊤ := E1Sign.connMass_ne_top M r h2
  have hE : E1Sign.exclMass M r ≠ ⊤ := by
    have hp : E1Sign.pairMass M r ≠ ⊤ := E1Sign.pairMass_ne_top M r h2
    rw [E1Sign.pairMass_eq M r] at hp
    exact (ENNReal.add_ne_top.1 hp).2
  rw [ENNReal.toReal_add hT hE]
  ring

end PivotFlux
end PercLib.CriticalLRP

/-! ## The same mass transport for every `p` (the paper's general moment flux)

`pivotWeight` above is the `p = 1` weight, where the binomial increment is exactly `|K_y|`
and no `ENNReal` subtraction is needed.  For general `p` the increment
`(|K_b| + |K_c|)^p − |K_b|^p` has to be taken in `ℝ` (the landed `MassTransportI41` convention,
which sets an infinite cluster's volume to `0` through `ENNReal.toReal`); that is
`binomWeight`.  The mass-transport identity is proved here for every `p` at the *source model*
with its arbitrary normalized norm, which the landed `linfNorm`-specific
`MassTransportI41.i41_massTransport` does not cover. -/

namespace PercLib.CriticalLRP
namespace PivotFlux

open MeasureTheory Orchestration
open scoped ENNReal NNReal

variable (M : SourceModelData)

/-- The general-`p` weight is covariant under lattice translations. -/
theorem binomWeight_shift (p : ℕ) (r : ℝ) (t : M.V) (ω : Config M.V) (a b c : M.V) :
    binomWeight M p r (shiftConfig t ω) (a + t) (b + t) (c + t)
      = binomWeight M p r ω a b c := by
  simp only [binomWeight, configIndicator_connects_shift t a b ω,
    configIndicator_not_connects_shift t b c ω, clusterVolR_shiftConfig]
  have hsub : (c + t) - (b + t) = c - b := by abel
  simp only [SourceNormData.dist, hsub]
  rfl

/-- The general-`p` weight is measurable in the configuration. -/
theorem measurable_binomWeight (p : ℕ) (r : ℝ) (a b c : M.V) :
    Measurable fun ω : Config M.V => binomWeight M p r ω a b c := by
  have h1 : Measurable fun ω : Config M.V =>
      configIndicator {ω' : Config M.V | Connects ω' a b} ω :=
    measurable_configIndicator (measurableSet_connects a b)
  have h2 : Measurable fun ω : Config M.V =>
      configIndicator {ω' : Config M.V | ¬ Connects ω' b c} ω :=
    measurable_configIndicator (measurableSet_connects b c).compl
  have h3 : Measurable fun ω : Config M.V =>
      ENNReal.ofReal ((clusterVolR ω b + clusterVolR ω c) ^ p - clusterVolR ω b ^ p) := by
    apply Measurable.ennreal_ofReal
    exact (((measurable_clusterVolR b).add (measurable_clusterVolR c)).pow_const p).sub
      ((measurable_clusterVolR b).pow_const p)
  exact ((h1.mul measurable_const).mul h2).mul h3

/-- At the root `b = 0` the general weight factors into the anchor indicator and the rooted
summand. -/
theorem tsum_binomWeight_eq (p : ℕ) (r : ℝ) (ω : Config M.V) (a : M.V) :
    (∑' c : M.V, binomWeight M p r ω a 0 c)
      = configIndicator {ω' : Config M.V | Connects ω' a (0 : M.V)} ω *
        ∑' c : M.V, (if M.S.ρ (toVec c) ≤ r then 1 else 0) *
          configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) c} ω *
          ENNReal.ofReal ((clusterVolR ω (0 : M.V) + clusterVolR ω c) ^ p -
            clusterVolR ω (0 : M.V) ^ p) := by
  have h : (∑' c : M.V, binomWeight M p r ω a 0 c)
      = ∑' c : M.V, configIndicator {ω' : Config M.V | Connects ω' a (0 : M.V)} ω *
          ((if M.S.ρ (toVec c) ≤ r then 1 else 0) *
            configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) c} ω *
              ENNReal.ofReal ((clusterVolR ω (0 : M.V) + clusterVolR ω c) ^ p -
                clusterVolR ω (0 : M.V) ^ p)) :=
    tsum_congr fun c => by
      simp only [binomWeight, SourceNormData.dist, sub_zero, mul_assoc]
  rw [h, ENNReal.tsum_mul_left]

/-- The reindexed general double sum is the rooted general flux integrand. -/
theorem tsum_tsum_binomWeight_eq (p : ℕ) (r : ℝ) (ω : Config M.V) :
    (∑' a : M.V, ∑' c : M.V, binomWeight M p r ω a 0 c) = rootedSumP M p r ω := by
  rw [rootedSumP]
  calc (∑' a : M.V, ∑' c : M.V, binomWeight M p r ω a 0 c)
      = ∑' a : M.V, configIndicator {ω' : Config M.V | Connects ω' a 0} ω *
          (∑' c : M.V, (if M.S.ρ (toVec c) ≤ r then 1 else 0) *
            configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) c} ω *
            ENNReal.ofReal ((clusterVolR ω (0 : M.V) + clusterVolR ω c) ^ p -
              clusterVolR ω (0 : M.V) ^ p)) :=
        tsum_congr fun a => tsum_binomWeight_eq M p r ω a
    _ = (∑' a : M.V, configIndicator {ω' : Config M.V | Connects ω' a 0} ω) *
          (∑' c : M.V, (if M.S.ρ (toVec c) ≤ r then 1 else 0) *
            configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) c} ω *
            ENNReal.ofReal ((clusterVolR ω (0 : M.V) + clusterVolR ω c) ^ p -
              clusterVolR ω (0 : M.V) ^ p)) :=
        ENNReal.tsum_mul_right
    _ = clusterVol ω (0 : M.V) *
          (∑' c : M.V, (if M.S.ρ (toVec c) ≤ r then 1 else 0) *
            configIndicator {ω' : Config M.V | ¬ Connects ω' (0 : M.V) c} ω *
            ENNReal.ofReal ((clusterVolR ω (0 : M.V) + clusterVolR ω c) ^ p -
              clusterVolR ω (0 : M.V) ^ p)) := by
        rw [tsum_connects_indicator]

/-- The expectation of the paper's general-`p` double sum is the double sum of expectations. -/
theorem lintegral_paperSumP (μ : Measure (Config M.V)) (p : ℕ) (r : ℝ) :
    ∫⁻ ω, (∑' b : M.V, ∑' c : M.V, binomWeight M p r ω 0 b c) ∂μ
      = ∑' b : M.V, ∑' c : M.V, ∫⁻ ω, binomWeight M p r ω 0 b c ∂μ := by
  rw [lintegral_tsum]
  · refine tsum_congr fun b => ?_
    rw [lintegral_tsum]
    exact fun c => (measurable_binomWeight M p r 0 b c).aemeasurable
  · exact fun b => (Measurable.tsum fun c => measurable_binomWeight M p r 0 b c).aemeasurable

/-- The symmetric interchange for the root-anchored general-`p` form. -/
theorem lintegral_rootedP (μ : Measure (Config M.V)) (p : ℕ) (r : ℝ) :
    ∫⁻ ω, (∑' a : M.V, ∑' c : M.V, binomWeight M p r ω a 0 c) ∂μ
      = ∑' a : M.V, ∑' c : M.V, ∫⁻ ω, binomWeight M p r ω a 0 c ∂μ := by
  rw [lintegral_tsum]
  · refine tsum_congr fun b => ?_
    rw [lintegral_tsum]
    exact fun c => (measurable_binomWeight M p r b 0 c).aemeasurable
  · exact fun b => (Measurable.tsum fun c => measurable_binomWeight M p r b 0 c).aemeasurable

/-- Translation invariance of a general-`p` edge weight in expectation. -/
theorem integral_binomWeight_shift (p : ℕ) (r : ℝ) (a b c t : M.V) :
    ∫⁻ ω, binomWeight M p r ω (a + t) (b + t) (c + t) ∂(M.cutLaw r)
      = ∫⁻ ω, binomWeight M p r ω a b c ∂(M.cutLaw r) := by
  calc ∫⁻ ω, binomWeight M p r ω (a + t) (b + t) (c + t) ∂(M.cutLaw r)
      = ∫⁻ ω, binomWeight M p r (shiftConfig (-t) ω) a b c ∂(M.cutLaw r) := by
        refine lintegral_congr fun ω => ?_
        simpa using (binomWeight_shift M p r (-t) ω (a + t) (b + t) (c + t)).symm
    _ = ∫⁻ ω, binomWeight M p r ω a b c ∂(M.cutLaw r).map (shiftConfig (-t)) := by
        rw [lintegral_map (measurable_binomWeight M p r a b c) (measurable_shiftConfig (-t))]
    _ = _ := by rw [M.cutLaw_map_shiftConfig r (-t)]

/-- **The mass-transport step of Lemma I.4.1 at the source model, every `p`.** -/
theorem massTransport_binom (p : ℕ) (r : ℝ) :
    (∑' b : M.V, ∑' c : M.V, ∫⁻ ω, binomWeight M p r ω 0 b c ∂(M.cutLaw r))
      = ∑' a : M.V, ∑' c : M.V, ∫⁻ ω, binomWeight M p r ω a 0 c ∂(M.cutLaw r) :=
  tsum_mass_transport₃ (fun a b c => ∫⁻ ω, binomWeight M p r ω a b c ∂(M.cutLaw r))
    (fun a b c t => integral_binomWeight_shift M p r a b c t)

/-- **Lemma I.4.1, mass-transport step, general `p`, at the actual source model.**
For every `p` and every radius,
`E[sum_{x in K} sum_{y in B_r(x)} 1(y notin K)((|K|+|K_y|)^p - |K|^p)]`
equals the rooted expectation
`E[|K_0| sum_{y in B_r} 1(y notin K_0)((|K_0|+|K_y|)^p - |K_0|^p)]`.
Unconditional in `ENNReal`; no moment finiteness is used. -/
theorem lintegral_paperSumP_eq_rooted (p : ℕ) (r : ℝ) :
    ∫⁻ ω, paperSumP M p r ω ∂(M.cutLaw r) = ∫⁻ ω, rootedSumP M p r ω ∂(M.cutLaw r) := by
  unfold paperSumP
  calc ∫⁻ ω, (∑' b : M.V, ∑' c : M.V, binomWeight M p r ω 0 b c) ∂(M.cutLaw r)
      = ∑' b : M.V, ∑' c : M.V, ∫⁻ ω, binomWeight M p r ω 0 b c ∂(M.cutLaw r) :=
        lintegral_paperSumP M _ p r
    _ = ∑' a : M.V, ∑' c : M.V, ∫⁻ ω, binomWeight M p r ω a 0 c ∂(M.cutLaw r) :=
        massTransport_binom M p r
    _ = ∫⁻ ω, (∑' a : M.V, ∑' c : M.V, binomWeight M p r ω a 0 c) ∂(M.cutLaw r) :=
        (lintegral_rootedP M _ p r).symm
    _ = ∫⁻ ω, rootedSumP M p r ω ∂(M.cutLaw r) :=
        lintegral_congr fun ω => tsum_tsum_binomWeight_eq M p r ω

/-- At `p = 1` the general weight coincides with the exact increment weight `pivotWeight`
whenever the cluster volumes of the configuration are finite in the sense
`clusterVol ω v ≠ ⊤` (the only case in which the `ℝ`-valued difference and the exact `ENNReal`
increment agree; if a cluster is infinite, `clusterVolR` is `0` by the `toReal` convention and
the general weight loses that term, while `pivotWeight` keeps `⊤`). -/
theorem binomWeight_one_eq_pivotWeight_of_ne_top (r : ℝ) (ω : Config M.V)
    (hfin : ∀ v : M.V, clusterVol ω v ≠ ⊤) (a b c : M.V) :
    binomWeight M 1 r ω a b c = pivotWeight M r ω a b c := by
  have hct : clusterVol ω c = ENNReal.ofReal (clusterVolR ω c) :=
    BinomialI41.clusterVol_eq_ofReal_clusterVolR (hfin c)
  have hpow : ((clusterVolR ω b + clusterVolR ω c) ^ 1 - clusterVolR ω b ^ 1)
      = clusterVolR ω c := by ring
  unfold binomWeight pivotWeight
  rw [hpow, hct]

end PivotFlux
end PercLib.CriticalLRP

/-! ## The finite anchor summation at `p = 1`

The infinite-volume mass transport of `pf_flux.lean` has a *literal* finite counterpart:
inside one configuration, summing the pivotal increment of the `p`-th moment over the anchors
of the merged cluster gives `|K|^{l+1}|K_y|^{p-l}`
(`FiniteRusso.RussoHandoff.sum_clusterMoment_flip_eq_sum`).  At `p = 1` this is exactly the
`|K||K_y|` weight that the mass-transport step produces in expectation, which is why the
`p = 1` binomial collapse is the right finite input for the first-moment ODE. -/

namespace PercLib.CriticalLRP
namespace PivotFlux

open PercLib.CriticalLRP.FiniteVolume.RussoHandoff

variable {E : Type*} [Fintype E] [DecidableEq E]
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- **The finite anchor sum at `p = 1`:** summing the single-edge flip increments of
`|K_x|` over the anchors `x` of the merged cluster gives `|K_{s e}| |K_{t e}|`. -/
theorem sum_clusterMoment_one_flip_eq_card_mul {s t : E → V} {e : E} {ω : Configuration E}
    (hxy : ¬ PercLib.CriticalLRP.FiniteVolume.Conn s t ω (s e) (t e)) :
    (∑ x ∈ PercLib.CriticalLRP.FiniteVolume.cluster s t ω (s e),
        (clusterMoment s t x 1 (insert e ω) - clusterMoment s t x 1 ω))
      = ((PercLib.CriticalLRP.FiniteVolume.cluster s t ω (s e)).card : ℝ)
        * ((PercLib.CriticalLRP.FiniteVolume.cluster s t ω (t e)).card : ℝ) := by
  rw [sum_clusterMoment_flip_eq_sum (s := s) (t := t) (e := e) (ω := ω) 1 hxy]
  simp

/-- The same statement in the `leftWeight`/`rightWeight` coordinates of the finite pivotal
flux: at `p = 1` the total binomial weight of the flip, summed over the anchors of the merged
cluster, is `|K_{s e}| |K_{t e}|`. -/
theorem sum_weights_one_eq_card_mul {s t : E → V} {e : E} {ω : Configuration E}
    (hxy : ¬ PercLib.CriticalLRP.FiniteVolume.Conn s t ω (s e) (t e)) :
    (∑ x ∈ PercLib.CriticalLRP.FiniteVolume.cluster s t ω (s e),
        (leftWeight s t x 1 e ω + rightWeight s t x 1 e ω))
      = ((PercLib.CriticalLRP.FiniteVolume.cluster s t ω (s e)).card : ℝ)
        * ((PercLib.CriticalLRP.FiniteVolume.cluster s t ω (t e)).card : ℝ) := by
  refine Eq.trans (Finset.sum_congr rfl fun x _ => ?_)
    (sum_clusterMoment_one_flip_eq_card_mul (s := s) (t := t) (e := e) (ω := ω) hxy)
  exact (clusterMoment_flip_eq_left_add_right (s := s) (t := t) (e := e) (x := x) (ω := ω) 1).symm

end PivotFlux
end PercLib.CriticalLRP

/-! ## The real algebra: from the excluded window moment to the source ODE rate -/

namespace PercLib.CriticalLRP
namespace PivotFlux

open MeasureTheory Filter Asymptotics Orchestration
open scoped ENNReal NNReal Topology

variable (M : SourceModelData)

/-- **The excluded window moment is `|B_r| chi^2 (1 - E_{1,r})`.**

This is the `p = 1` pivot identity `S - T = |B_r| (E|K|)^2 (1 - E_{1,r})` of the paper, at the
model's own cutoff moments: `S = pairMass.toReal`, `T = connMass.toReal`, and
`S - T = exclMass.toReal` is `E1Sign.pairMass_eq` converted to `ℝ` under a finite second
cutoff moment.  No probabilistic input beyond that finiteness enters. -/
theorem exclMass_toReal_eq (r : ℝ) (hr : 0 ≤ r) (h2 : M.cutMoment 2 r ≠ ⊤) :
    (E1Sign.exclMass M r).toReal
      = ((M.ball r).ncard : ℝ) * (M.cutMassAt r 0).toReal ^ 2 * (1 - cutE1 M r) := by
  have hA : M.cutMassAt r 0 ≠ ⊤ :=
    ne_top_of_le_ne_top h2 (E1Sign.cutMassAt_le_cutMoment_two M r)
  have hA1 : (1 : ℝ) ≤ (M.cutMassAt r 0).toReal := by
    have h := ENNReal.toReal_mono hA (E1Sign.one_le_cutMassAt M r)
    simpa using h
  have hApos : (0 : ℝ) < (M.cutMassAt r 0).toReal := by linarith
  have hzero : (0 : M.V) ∈ M.ball r := by
    change M.S.ρ (toVec (0 : M.V)) ≤ r
    have h0 : toVec (0 : M.V) = 0 := by
      funext i
      simp [toVec]
    rw [h0, M.S.ρ_zero]
    exact hr
  have hbpos : 0 < (M.ball r).ncard := (Set.ncard_pos (M.finite_ball r)).mpr ⟨0, hzero⟩
  have hbR : (0 : ℝ) < ((M.ball r).ncard : ℝ) := by exact_mod_cast hbpos
  have hT : E1Sign.connMass M r ≠ ⊤ := E1Sign.connMass_ne_top M r h2
  have hE : E1Sign.exclMass M r ≠ ⊤ := by
    have hp : E1Sign.pairMass M r ≠ ⊤ := E1Sign.pairMass_ne_top M r h2
    rw [E1Sign.pairMass_eq M r] at hp
    exact (ENNReal.add_ne_top.1 hp).2
  have hST : (E1Sign.pairMass M r).toReal - (E1Sign.connMass M r).toReal
      = (E1Sign.exclMass M r).toReal := by
    have hsplit : (E1Sign.pairMass M r).toReal
        = (E1Sign.connMass M r).toReal + (E1Sign.exclMass M r).toReal := by
      rw [E1Sign.pairMass_eq M r, ENNReal.toReal_add hT hE]
    linarith
  have hbA : ((M.ball r).ncard : ℝ) * (M.cutMassAt r 0).toReal ^ 2 ≠ 0 :=
    ne_of_gt (by positivity)
  rw [cutE1, ← hST]
  simp only [VolumeMoments.cE1]
  field_simp
  ring

/-- **The (I.4.5) rate.**  If the first cutoff mass differentiates with the standardized
`p = 1` flux, then its derivative is `b_c|K'(r)|(S - T)` where `S - T` is the expectation of
the paper's double sum `sum_{x in K} sum_{y in B_r(x)} 1(y notin K)|K_y|`. -/
theorem flux_eq_pairMass_sub_connMass {F' : ℝ → ℝ} {r : ℝ} (hr : 0 ≤ r)
    (h2 : M.cutMoment 2 r ≠ ⊤)
    (hflux : F' r = (M.betaCrit : ℝ) * |deriv M.K r| * (E1Sign.exclMass M r).toReal) :
    F' r = (M.betaCrit : ℝ) * |deriv M.K r|
      * ((E1Sign.pairMass M r).toReal - (E1Sign.connMass M r).toReal)
      ∧ (E1Sign.pairMass M r).toReal - (E1Sign.connMass M r).toReal
        = (∫⁻ ω, paperSum M r ω ∂(M.cutLaw r)).toReal := by
  have h := toReal_paperSum_eq_pairMass_sub_connMass M r h2
  have hE : (E1Sign.exclMass M r).toReal
      = (E1Sign.pairMass M r).toReal - (E1Sign.connMass M r).toReal := by
    have hT : E1Sign.connMass M r ≠ ⊤ := E1Sign.connMass_ne_top M r h2
    have hEt : E1Sign.exclMass M r ≠ ⊤ := by
      have hp : E1Sign.pairMass M r ≠ ⊤ := E1Sign.pairMass_ne_top M r h2
      rw [E1Sign.pairMass_eq M r] at hp
      exact (ENNReal.add_ne_top.1 hp).2
    have hsplit : (E1Sign.pairMass M r).toReal
        = (E1Sign.connMass M r).toReal + (E1Sign.exclMass M r).toReal := by
      rw [E1Sign.pairMass_eq M r, ENNReal.toReal_add hT hEt]
    linarith
  exact ⟨by rw [hflux, hE], h.symm⟩

/-- **The assembled source ODE (I.4.6) from the standardized flux.**  If the first cutoff mass
has derivative `b_c|K'(t)| (exclMass t).toReal` — the (I.4.5) display, i.e. the standardized
flux — then it satisfies the ODE in exactly the shape consumed by
`E1Sign.eventually_cutMassAt_rpow_le_of_model_defect`, with the *model's own* defects
`cutE1` and `cutE0`. -/
theorem cutMass_ODE_of_flux {r₀ : ℝ} {F' : ℝ → ℝ} (hr₀ : 0 < r₀)
    (h2 : ∀ t : ℝ, r₀ ≤ t → M.cutMoment 2 t ≠ ⊤)
    (hflux : ∀ t : ℝ, r₀ ≤ t →
      F' t = (M.betaCrit : ℝ) * |deriv M.K t| * (E1Sign.exclMass M t).toReal) :
    ∀ t : ℝ, r₀ ≤ t →
      F' t = (1 - (1 - (1 - cutE0 M t) * (1 - cutE1 M t))) * (M.betaCrit : ℝ)
        * t ^ (-M.α - 1) * ((M.cutMassAt t 0).toReal) ^ 2 := by
  intro t ht
  have htpos : 0 < t := lt_of_lt_of_le hr₀ ht
  have hA : M.cutMassAt t 0 ≠ ⊤ :=
    ne_top_of_le_ne_top (h2 t ht) (E1Sign.cutMassAt_le_cutMoment_two M t)
  have hA1 : (1 : ℝ) ≤ (M.cutMassAt t 0).toReal := by
    have h := ENNReal.toReal_mono hA (E1Sign.one_le_cutMassAt M t)
    simpa using h
  have hApos : (0 : ℝ) < (M.cutMassAt t 0).toReal := by linarith
  have hzero : (0 : M.V) ∈ M.ball t := by
    change M.S.ρ (toVec (0 : M.V)) ≤ t
    have h0 : toVec (0 : M.V) = 0 := by
      funext i
      simp [toVec]
    rw [h0, M.S.ρ_zero]
    exact htpos.le
  have hbpos : 0 < (M.ball t).ncard := (Set.ncard_pos (M.finite_ball t)).mpr ⟨0, hzero⟩
  have hbR : (0 : ℝ) < ((M.ball t).ncard : ℝ) := by exact_mod_cast hbpos
  have hST : (E1Sign.pairMass M t).toReal - (E1Sign.connMass M t).toReal
      = (E1Sign.exclMass M t).toReal := by
    have hT : E1Sign.connMass M t ≠ ⊤ := E1Sign.connMass_ne_top M t (h2 t ht)
    have hEt : E1Sign.exclMass M t ≠ ⊤ := by
      have hp : E1Sign.pairMass M t ≠ ⊤ := E1Sign.pairMass_ne_top M t (h2 t ht)
      rw [E1Sign.pairMass_eq M t] at hp
      exact (ENNReal.add_ne_top.1 hp).2
    have hsplit : (E1Sign.pairMass M t).toReal
        = (E1Sign.connMass M t).toReal + (E1Sign.exclMass M t).toReal := by
      rw [E1Sign.pairMass_eq M t, ENNReal.toReal_add hT hEt]
    linarith
  have hEbar : VolumeMoments.oneSubEbar1 (VolumeMoments.cE1 (M.cutMassAt t 0).toReal
        (E1Sign.pairMass M t).toReal (E1Sign.connMass M t).toReal ((M.ball t).ncard : ℝ))
        |deriv M.K t| ((M.ball t).ncard : ℝ) t M.α
      = (1 - cutE0 M t) * (1 - cutE1 M t) := by
    unfold VolumeMoments.oneSubEbar1 cutE0 cutE1 VolumeMoments.oneSubE0
    ring
  have hkey := VolumeMoments.first_moment_ODE_of_pivot
    (A := (M.cutMassAt t 0).toReal) (S := (E1Sign.pairMass M t).toReal)
    (T := (E1Sign.connMass M t).toReal) (b := ((M.ball t).ncard : ℝ))
    (J := |deriv M.K t|) (β := (M.betaCrit : ℝ)) (r := t) (α := M.α) hApos hbR htpos
  have hcoef : (1 - (1 - (1 - cutE0 M t) * (1 - cutE1 M t)))
      = VolumeMoments.oneSubEbar1 (VolumeMoments.cE1 (M.cutMassAt t 0).toReal
          (E1Sign.pairMass M t).toReal (E1Sign.connMass M t).toReal ((M.ball t).ncard : ℝ))
          |deriv M.K t| ((M.ball t).ncard : ℝ) t M.α := by
    rw [← hEbar]
    ring
  rw [hflux t ht, ← hST, hcoef]
  exact hkey

/-! ## The standardization error vanishes

`E_{0,r} = 1 - |K'(r)||B_r| r^{a+1}` is *not* an extra hypothesis: it tends to `0` at the
model's own data.  The only inputs are the source's power law
`|K'(r)| = (1 + δ r) r^{-d-a-1}` with a logarithmic error `δ -> 0` (`SourceModelData.exists_error`)
and the normalized ball count `|B_r| ~ r^d` (`SourceModelData.ball_count`, which uses the
normalized unit ball `volume{b : rho b <= 1} = 1`). -/

/-- `|K'| |B_r| r^{a+1} -> 1` from a power-law kernel error and the ball count. -/
theorem tendsto_oneSubE0 (δ : ℝ → ℝ)
    (hδ : ∀ r : ℝ, 0 < r → |deriv M.K r| = (1 + δ r) * r ^ (-(M.d : ℝ) - M.α - 1))
    (hδ0 : Tendsto δ atTop (𝓝 0)) :
    Tendsto (fun r : ℝ => VolumeMoments.oneSubE0 |deriv M.K r| ((M.ball r).ncard : ℝ) r M.α)
      atTop (𝓝 1) := by
  have hne : ∀ᶠ r : ℝ in atTop, r ^ M.d ≠ 0 := by
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
    exact pow_ne_zero M.d (ne_of_gt hr)
  have hbd : Tendsto (fun r : ℝ => ((M.ball r).ncard : ℝ) / r ^ M.d) atTop (𝓝 1) :=
    (isEquivalent_iff_tendsto_one hne).mp M.ball_count
  have hrpow : Tendsto (fun r : ℝ => ((M.ball r).ncard : ℝ) * r ^ (-(M.d : ℝ))) atTop (𝓝 1) := by
    refine hbd.congr' ?_
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
    rw [Real.rpow_neg hr.le, div_eq_mul_inv, Real.rpow_natCast, inv_eq_one_div]
  have hprod : Tendsto
      (fun r : ℝ => (1 + δ r) * (((M.ball r).ncard : ℝ) * r ^ (-(M.d : ℝ)))) atTop (𝓝 1) := by
    have h1 : Tendsto (fun r : ℝ => 1 + δ r) atTop (𝓝 (1 + 0)) :=
      tendsto_const_nhds.add hδ0
    have := h1.mul hrpow
    simpa using this
  refine hprod.congr' ?_
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
  have hrpow' : r ^ (-(M.d : ℝ) - M.α - 1) * r ^ (M.α + 1) = r ^ (-(M.d : ℝ)) := by
    rw [← Real.rpow_add hr]
    congr 1
    ring
  unfold VolumeMoments.oneSubE0
  rw [hδ r hr]
  calc (1 + δ r) * (((M.ball r).ncard : ℝ) * r ^ (-(M.d : ℝ)))
      = (1 + δ r) * ((M.ball r).ncard : ℝ) * r ^ (-(M.d : ℝ)) := by ring
    _ = (1 + δ r) * ((M.ball r).ncard : ℝ)
          * (r ^ (-(M.d : ℝ) - M.α - 1) * r ^ (M.α + 1)) := by rw [hrpow']
    _ = (1 + δ r) * r ^ (-(M.d : ℝ) - M.α - 1) * ((M.ball r).ncard : ℝ) * r ^ (M.α + 1) := by
        ring

/-- **The standardization error vanishes at the model's own data.** -/
theorem tendsto_cutE0 : Tendsto (cutE0 M) atTop (𝓝 0) := by
  obtain ⟨δ, hδ, hδlog⟩ := M.exists_error
  have h := tendsto_oneSubE0 M δ hδ hδlog.2
  have h' : Tendsto (fun r : ℝ => 1 - VolumeMoments.oneSubE0 |deriv M.K r|
      ((M.ball r).ncard : ℝ) r M.α) atTop (𝓝 (1 - 1)) := tendsto_const_nhds.sub h
  have hfun : cutE0 M = fun r : ℝ => 1 - VolumeMoments.oneSubE0 |deriv M.K r|
      ((M.ball r).ncard : ℝ) r M.α := rfl
  rw [hfun]
  simpa using h'

/-! ## Assembly: the source's eventual lower comparison from the standardized flux -/

/-- **Corollary I.4.8 shape from the standardized flux and the model's own defect.**

All model-side algebraic inputs are discharged: the mass-transport reduction
(`lintegral_paperSum_eq_exclMass`), the pivot algebra (`first_moment_ODE_of_pivot`), and the
vanishing standardization error (`tendsto_cutE0`).  What remains as explicit hypotheses is
exactly the still-open analytic part: the differentiation `HasDerivAt` of the cutoff mass
together with the derivative-to-standardized-flux identity `hflux`, positivity of the cutoff
mass, its divergence, and finiteness of the second cutoff moment on `[r₀,∞)`. -/
theorem eventually_cutMassAt_rpow_le_of_flux {r₀ : ℝ} {F' : ℝ → ℝ}
    (hβ : 0 < (M.betaCrit : ℝ)) (hr₀ : 0 < r₀)
    (hderiv : ∀ t : ℝ, r₀ ≤ t →
      HasDerivAt (fun t => (M.cutMassAt t 0).toReal) (F' t) t)
    (hpos : ∀ t : ℝ, r₀ ≤ t → 0 < (M.cutMassAt t 0).toReal)
    (hinf : Tendsto (fun t => (M.cutMassAt t 0).toReal) atTop atTop)
    (h2 : ∀ t : ℝ, r₀ ≤ t → M.cutMoment 2 t ≠ ⊤)
    (hflux : ∀ t : ℝ, r₀ ≤ t →
      F' t = (M.betaCrit : ℝ) * |deriv M.K t| * (E1Sign.exclMass M t).toReal) :
    ∀ᶠ r : ℝ in atTop,
      M.α / ((M.betaCrit : ℝ) * 2) * r ^ M.α ≤ (M.cutMassAt r 0).toReal :=
  E1Sign.eventually_cutMassAt_rpow_le_of_model_defect M hβ hr₀ hderiv hpos hinf
    (cutMass_ODE_of_flux M hr₀ h2 hflux) (tendsto_cutE0 M) h2


/-- **Lemma I.4.7's upper half in flux form.**  The standardized flux is dominated by the
mean-field rate `|B_r| chi^2`: the `p = 1` right-hand side of (I.4.5) is at most
`|B_r| (E|K|)^2`, which is what makes the ODE coefficient nonnegative once the defect `E_{1,r}`
is bounded by one. -/
theorem toReal_lintegral_paperSum_le (r : ℝ) (h2 : M.cutMoment 2 r ≠ ⊤) :
    (∫⁻ ω, paperSum M r ω ∂(M.cutLaw r)).toReal
      ≤ ((M.ball r).ncard : ℝ) * (M.cutMassAt r 0).toReal ^ 2 := by
  have hA : M.cutMassAt r 0 ≠ ⊤ :=
    ne_top_of_le_ne_top h2 (E1Sign.cutMassAt_le_cutMoment_two M r)
  have hT : E1Sign.connMass M r ≠ ⊤ := E1Sign.connMass_ne_top M r h2
  have hle := E1Sign.exclMass_le M r hT
  rw [lintegral_paperSum_eq_exclMass]
  have htop : ((M.ball r).ncard : ℝ≥0∞) * (M.cutMassAt r 0) ^ 2 ≠ ⊤ :=
    ENNReal.mul_ne_top (by simp) (ENNReal.pow_ne_top hA)
  have h := ENNReal.toReal_mono htop hle
  rwa [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.toReal_natCast] at h

/-- **The mean-field upper bound on the standardized flux, pointwise in the radius.**
`F' r ≤ b_c|K'(r)| |B_r| chi(r)^2`, the source's `(*) ≤` step in the passage from (I.4.5) to
the upper comparison of Lemma I.4.5.  No sign hypothesis on the defect is used, and the
only finiteness is the second cutoff moment. -/
theorem flux_le_ball_mul {F' : ℝ → ℝ} {r : ℝ} (h2 : M.cutMoment 2 r ≠ ⊤)
    (hflux : F' r = (M.betaCrit : ℝ) * |deriv M.K r|
      * (∫⁻ ω, paperSum M r ω ∂(M.cutLaw r)).toReal) :
    F' r ≤ (M.betaCrit : ℝ) * |deriv M.K r|
      * (((M.ball r).ncard : ℝ) * (M.cutMassAt r 0).toReal ^ 2) := by
  rw [hflux]
  refine mul_le_mul_of_nonneg_left (toReal_lintegral_paperSum_le M r h2) ?_
  exact mul_nonneg (NNReal.coe_nonneg _) (abs_nonneg _)

/-- **The upper ODE (Lemma I.4.5's upper comparison) from the paper's double sum.**
`F' t ≤ (1 - E_{0,t}) b_c t^{-a-1} chi(t)^2`, with the model's own standardization error
`cutE0`.  This is the upper-comparison counterpart of `cutMass_ODE_of_flux` and needs no
sign of `E_{1,t}`: the bound `S - T ≤ |B_r| chi^2` of Lemma I.4.7's upper half is used. -/
theorem cutMass_upper_ODE_of_paperFlux {r₀ : ℝ} {F' : ℝ → ℝ} (hr₀ : 0 < r₀)
    (h2 : ∀ t : ℝ, r₀ ≤ t → M.cutMoment 2 t ≠ ⊤)
    (hflux : ∀ t : ℝ, r₀ ≤ t → F' t = (M.betaCrit : ℝ) * |deriv M.K t|
      * (∫⁻ ω, paperSum M t ω ∂(M.cutLaw t)).toReal) :
    ∀ t : ℝ, r₀ ≤ t →
      F' t ≤ (1 - cutE0 M t) * (M.betaCrit : ℝ) * t ^ (-M.α - 1)
        * ((M.cutMassAt t 0).toReal) ^ 2 := by
  intro t ht
  have htpos : 0 < t := lt_of_lt_of_le hr₀ ht
  have hb := flux_le_ball_mul M (h2 t ht) (hflux t ht)
  have hrpow : t ^ (M.α + 1) * t ^ (-M.α - 1) = 1 := by
    rw [← Real.rpow_add htpos]
    norm_num
  have hEb : (1 - cutE0 M t) * (M.betaCrit : ℝ) * t ^ (-M.α - 1)
        * ((M.cutMassAt t 0).toReal) ^ 2
      = (M.betaCrit : ℝ) * |deriv M.K t|
        * (((M.ball t).ncard : ℝ) * (M.cutMassAt t 0).toReal ^ 2) := by
    unfold cutE0 VolumeMoments.oneSubE0
    have hJb : |deriv M.K t| * ((M.ball t).ncard : ℝ) * t ^ (M.α + 1)
        * (t ^ (-M.α - 1) * ((M.cutMassAt t 0).toReal) ^ 2)
        = |deriv M.K t| * ((M.ball t).ncard : ℝ) * ((M.cutMassAt t 0).toReal) ^ 2 := by
      calc |deriv M.K t| * ((M.ball t).ncard : ℝ) * t ^ (M.α + 1)
            * (t ^ (-M.α - 1) * ((M.cutMassAt t 0).toReal) ^ 2)
          = |deriv M.K t| * ((M.ball t).ncard : ℝ)
              * (t ^ (M.α + 1) * t ^ (-M.α - 1)) * ((M.cutMassAt t 0).toReal) ^ 2 := by ring
        _ = |deriv M.K t| * ((M.ball t).ncard : ℝ)
              * ((M.cutMassAt t 0).toReal) ^ 2 := by rw [hrpow]; ring
    calc (1 - (1 - |deriv M.K t| * ((M.ball t).ncard : ℝ) * t ^ (M.α + 1)))
          * (M.betaCrit : ℝ) * t ^ (-M.α - 1) * ((M.cutMassAt t 0).toReal) ^ 2
        = (M.betaCrit : ℝ) * (|deriv M.K t| * ((M.ball t).ncard : ℝ) * t ^ (M.α + 1)
            * (t ^ (-M.α - 1) * ((M.cutMassAt t 0).toReal) ^ 2)) := by ring
      _ = (M.betaCrit : ℝ) * (|deriv M.K t| * ((M.ball t).ncard : ℝ)
            * ((M.cutMassAt t 0).toReal) ^ 2) := by rw [hJb]
      _ = (M.betaCrit : ℝ) * |deriv M.K t|
            * (((M.ball t).ncard : ℝ) * (M.cutMassAt t 0).toReal ^ 2) := by ring
  rw [hEb]
  exact hb

/-- **The assembled ODE with the hypothesis stated directly on the paper's double sum.**
The mass-transport identity `lintegral_paperSum_eq_exclMass` is consumed inside, so the
hypothesis is literally the right-hand side of (I.4.5) after multiplication by `b_c|K'(r)|`. -/
theorem cutMass_ODE_of_paperFlux {r₀ : ℝ} {F' : ℝ → ℝ} (hr₀ : 0 < r₀)
    (h2 : ∀ t : ℝ, r₀ ≤ t → M.cutMoment 2 t ≠ ⊤)
    (hflux : ∀ t : ℝ, r₀ ≤ t → F' t = (M.betaCrit : ℝ) * |deriv M.K t|
      * (∫⁻ ω, paperSum M t ω ∂(M.cutLaw t)).toReal) :
    ∀ t : ℝ, r₀ ≤ t →
      F' t = (1 - (1 - (1 - cutE0 M t) * (1 - cutE1 M t))) * (M.betaCrit : ℝ)
        * t ^ (-M.α - 1) * ((M.cutMassAt t 0).toReal) ^ 2 := by
  refine cutMass_ODE_of_flux M hr₀ h2 fun t ht => ?_
  rw [hflux t ht, lintegral_paperSum_eq_exclMass]

/-- **Corollary I.4.8 shape from the paper's double-sum form of (I.4.5).** -/
theorem eventually_cutMassAt_rpow_le_of_paperFlux {r₀ : ℝ} {F' : ℝ → ℝ}
    (hβ : 0 < (M.betaCrit : ℝ)) (hr₀ : 0 < r₀)
    (hderiv : ∀ t : ℝ, r₀ ≤ t →
      HasDerivAt (fun t => (M.cutMassAt t 0).toReal) (F' t) t)
    (hpos : ∀ t : ℝ, r₀ ≤ t → 0 < (M.cutMassAt t 0).toReal)
    (hinf : Tendsto (fun t => (M.cutMassAt t 0).toReal) atTop atTop)
    (h2 : ∀ t : ℝ, r₀ ≤ t → M.cutMoment 2 t ≠ ⊤)
    (hflux : ∀ t : ℝ, r₀ ≤ t → F' t = (M.betaCrit : ℝ) * |deriv M.K t|
      * (∫⁻ ω, paperSum M t ω ∂(M.cutLaw t)).toReal) :
    ∀ᶠ r : ℝ in atTop,
      M.α / ((M.betaCrit : ℝ) * 2) * r ^ M.α ≤ (M.cutMassAt r 0).toReal := by
  refine eventually_cutMassAt_rpow_le_of_flux M hβ hr₀ hderiv hpos hinf h2 fun t ht => ?_
  rw [hflux t ht, lintegral_paperSum_eq_exclMass]


/-- **Corollary I.4.8 shape with positivity of the cutoff mass derived, not assumed.**

`0 < chi(t)` on `[r₀,∞)` is *not* an extra hypothesis: `chi >= 1` by `one_le_cutMassAt` and
`chi < ⊤` by the second-moment hypothesis, so `toReal` of the cutoff mass is positive.  The
residual premises are then only the differentiation, its standardized-flux identity, the
divergence `chi -> ∞`, the finiteness of the second cutoff moment, and `β_c > 0`. -/
theorem eventually_cutMassAt_rpow_le_of_paperFlux' {r₀ : ℝ} {F' : ℝ → ℝ}
    (hβ : 0 < (M.betaCrit : ℝ)) (hr₀ : 0 < r₀)
    (hderiv : ∀ t : ℝ, r₀ ≤ t →
      HasDerivAt (fun t => (M.cutMassAt t 0).toReal) (F' t) t)
    (hinf : Tendsto (fun t => (M.cutMassAt t 0).toReal) atTop atTop)
    (h2 : ∀ t : ℝ, r₀ ≤ t → M.cutMoment 2 t ≠ ⊤)
    (hflux : ∀ t : ℝ, r₀ ≤ t → F' t = (M.betaCrit : ℝ) * |deriv M.K t|
      * (∫⁻ ω, paperSum M t ω ∂(M.cutLaw t)).toReal) :
    ∀ᶠ r : ℝ in atTop,
      M.α / ((M.betaCrit : ℝ) * 2) * r ^ M.α ≤ (M.cutMassAt r 0).toReal := by
  have hpos : ∀ t : ℝ, r₀ ≤ t → 0 < (M.cutMassAt t 0).toReal := by
    intro t ht
    have hA : M.cutMassAt t 0 ≠ ⊤ :=
      ne_top_of_le_ne_top (h2 t ht) (E1Sign.cutMassAt_le_cutMoment_two M t)
    have h1 : (1 : ℝ) ≤ (M.cutMassAt t 0).toReal := by
      have h := ENNReal.toReal_mono hA (E1Sign.one_le_cutMassAt M t)
      simpa using h
    linarith
  exact eventually_cutMassAt_rpow_le_of_paperFlux M hβ hr₀ hderiv hpos hinf h2 hflux

end PivotFlux
