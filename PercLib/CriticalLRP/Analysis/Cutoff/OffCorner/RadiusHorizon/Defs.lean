module

public import PercLib.CriticalLRP.CountableProduct.Base

/-!
# Horizon truncations of cylinder-open events

Swarm `smwv2c2lw`, member `m1`.

The events whose cutoff-radius dependence is at issue in the off-corner phase
(`{ω | Connects ω x y}`, the touching events, the forced open/closed connection events) are
**increasing and generated by finite witnesses**: a configuration is in the event because some
*finite* set of open edges already certifies it.

This file fixes that structure once, so that the analytic statements can refer to it:

* `posCyl F` is the positive cylinder `{ω | ↑F ⊆ ω}`;
* `CylinderOpen A` says every point of `A` has a finite witness `F ⊆ ω` all of whose supersets
  lie in `A` — exactly the open sets of the product of Sierpiński spaces on `Sym2 V`, which are
  automatically increasing;
* `horizon A S` keeps only those witnesses that lie inside the finite window `S`; it is the
  finite-horizon approximation of `A` on the edges of `S`;
* `patternConf S c` is the configuration whose edges inside `S` are given by `c` and which is
  empty outside `S`, and `horizonObs A S` is the indicator of `horizon A S` read through the
  pattern `S.restrict ω`.  This is the cylinder observable whose expectation is the horizon mass.

The point of the construction is that `horizon A S` depends on the finitely many edges in `S`
only, so its mass is a cylinder expectation (continuous in the cutoff radius), while it increases
to `A` as `S` grows over a cofinal sequence of finite windows.
-/

@[expose] public section

noncomputable section

set_option linter.unusedSectionVars false

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal Topology

namespace PercLib.CriticalLRP

variable {V : Type*} [Countable V]

/-- The positive cylinder generated by a finite edge set. -/
def posCyl (F : Finset (Sym2 V)) : Set (Config V) := {ω | (↑F : Set (Sym2 V)) ⊆ ω}

theorem mem_posCyl {F : Finset (Sym2 V)} {ω : Config V} :
    ω ∈ posCyl F ↔ (↑F : Set (Sym2 V)) ⊆ ω := Iff.rfl

/-- An event is generated by positive cylinders if every point of it has a finite witness all of
whose supersets remain in the event.  These are the open sets of the product of Sierpiński
spaces on `Sym2 V`; in particular they are increasing. -/
def CylinderOpen (A : Set (Config V)) : Prop :=
  ∀ ω ∈ A, ∃ F : Finset (Sym2 V), (↑F : Set (Sym2 V)) ⊆ ω ∧ posCyl F ⊆ A

/-- The horizon truncation of `A` on the finite window `S`: the union of the positive cylinders
contained in `A` and generated by sub-finsets of `S`. -/
def horizon (A : Set (Config V)) (S : Finset (Sym2 V)) : Set (Config V) :=
  ⋃ F ∈ S.powerset, ⋃ (_ : posCyl F ⊆ A), posCyl F

/-- The configuration with the edges prescribed by the pattern `c` on `S`, and no others. -/
def patternConf (S : Finset (Sym2 V)) (c : ↥S → Prop) : Config V :=
  {e | ∃ h : e ∈ S, c ⟨e, h⟩}

/-- The indicator of the horizon truncation, read as a cylinder observable through the pattern of
a configuration on `S`. -/
def horizonObs (A : Set (Config V)) (S : Finset (Sym2 V)) : (↥S → Prop) → ℝ :=
  fun c => (horizon A S).indicator (1 : Config V → ℝ) (patternConf S c)

end PercLib.CriticalLRP
