/-
Copyright (c) 2026 PercLib contributors. Released under Apache 2.0.

Swarm `smwpalb9h`, member m1, direction 1: adapted-revelation / conditional-product
input for the frontier moment bound on the repository's Bernoulli configuration law.

Main results:

* `lintegral_prod_coord`: for independent coordinates, the expectation of a finite
  product of one-coordinate observables factorizes (`ℝ≥0∞`-valued, no positivity and no
  integrability hypothesis).
* `lintegral_adapted_prod`: **the adapted-revelation factorization.** If the state fibre
  `{state = σ}` is a cylinder event on the revealed coordinates `reveal σ`, and the fresh
  monomial reads only coordinates outside `reveal σ`, then the joint expectation splits
  as `∑' σ, (∫⁻ over the fibre of the history) * (expectation of the fresh monomial)`.
  The random revealed set may be infinite, which is what an unbounded-degree frontier
  needs.
* `lintegral_adapted_pgf` / `lintegral_adapted_pgf_le`: the Bernoulli pgf form used by
  the generation induction, with the Poisson row-sum bound.

No finite-support, finite-window or finite-aggregate statement is used or proved.
-/
module

public import PercLib.Probability.Exploration.AdaptedReveal.Defs
public import Mathlib.Analysis.SpecialFunctions.Exp

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory
open scoped ENNReal
open PercLib.Probability

namespace PercLib.Probability.AdaptedReveal

variable {ι : Type*}

/-! ## Blocks: measurability -/

theorem blockRestrict_measurable (S : Set ι) : Measurable (blockRestrict S) := by
  apply Measurable.of_mem
  intro i
  exact (measurableSet_mem i.val).mem

theorem measurable_comap_blockRestrict {β : Type*} [MeasurableSpace β] (S : Set ι)
    (F : Set S → β) (hF : Measurable F) :
    Measurable[MeasurableSpace.comap (blockRestrict S) (inferInstance : MeasurableSpace (Set S))]
      (fun ω => F (blockRestrict S ω)) := by
  refine Measurable.of_comap_le ?_
  show MeasurableSpace.comap (F ∘ blockRestrict S) (inferInstance : MeasurableSpace β) ≤ _
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_iff_comap_le.mp hF)

/-! ## Coordinate `σ`-algebras and their sup over a block -/

theorem coordSigma_le (e : ι) :
    coordSigma e ≤ (inferInstance : MeasurableSpace (Set ι)) := by
  rw [coordSigma]
  exact measurable_iff_comap_le.mp (MeasurableSet.mem (measurableSet_mem e))

/-- The `σ`-algebra generated by all coordinates in a block.  For a finite block this is
the cylinder `σ`-algebra of that block; for an infinite block it is the `σ`-algebra of
the full restriction to that block, which is what an unbounded-degree history needs. -/
@[instance_reducible] def coordSup (S : Set ι) : MeasurableSpace (Set ι) := ⨆ e ∈ S, coordSigma e

theorem coordSigma_le_coordSup {S : Set ι} {e : ι} (he : e ∈ S) :
    coordSigma e ≤ coordSup S := by
  calc coordSigma e = ⨆ (_ : e ∈ S), coordSigma e :=
        (iSup_pos (f := fun _ => coordSigma e) he).symm
    _ ≤ coordSup S := le_iSup (fun i => ⨆ (_ : i ∈ S), coordSigma i) e

theorem coordSup_le (S : Set ι) : coordSup S ≤ (inferInstance : MeasurableSpace (Set ι)) := by
  refine iSup₂_le (f := fun i (_ : i ∈ S) => coordSigma i) ?_
  intro i _
  exact coordSigma_le i

/-- Any function of a single coordinate is measurable for the coordinate `σ`-algebra. -/
theorem measurable_coordSigma_comp (e : ι) {β : Type*} [MeasurableSpace β] (F : Prop → β) :
    Measurable[coordSigma e] (fun ω : Set ι => F (e ∈ ω)) := by
  refine Measurable.of_comap_le ?_
  show MeasurableSpace.comap (F ∘ fun ω : Set ι => e ∈ ω) (inferInstance : MeasurableSpace β) ≤ _
  rw [← MeasurableSpace.comap_comp]
  exact le_trans (MeasurableSpace.comap_mono le_top) le_rfl

/-- Coordinate `σ`-algebras are mutually independent for the Bernoulli product law. -/
theorem iIndep_coordSigma (p : ι → unitInterval) :
    iIndep (coordSigma (ι := ι)) (prodBernoulli p) :=
  (prodBernoulli_iIndepFun_mem p).iIndep

/-- Independence of the blocks `S` and `T` in coordinate form. -/
theorem indep_coordSup (p : ι → unitInterval) {S T : Set ι} (hST : Disjoint S T) :
    Indep (coordSup S) (coordSup T) (prodBernoulli p) :=
  indep_iSup_of_disjoint (fun _ => coordSigma_le _) (iIndep_coordSigma p) hST

/-- A finite product of one-coordinate observables is measurable for the `σ`-algebra of
the coordinates it reads. -/
theorem measurable_coordSup_finset_prod (S : Finset ι) (f : ι → Prop → ℝ≥0∞) :
    Measurable[coordSup (↑S : Set ι)] (fun ω : Set ι => ∏ e ∈ S, f e (e ∈ ω)) := by
  refine Finset.measurable_prod (m := coordSup (↑S : Set ι)) S ?_
  intro e he
  exact Measurable.mono (measurable_coordSigma_comp e (f e))
    (coordSigma_le_coordSup (Finset.mem_coe.mpr he)) le_rfl

/-! ## Expectation of a finite product of one-coordinate observables -/

/-- **Finite product factorization.** For independent coordinates, the expectation of a
finite product of one-coordinate observables is the product of the expectations. -/
theorem lintegral_prod_coord (p : ι → unitInterval) (S : Finset ι)
    (f : ι → Prop → ℝ≥0∞) :
    ∫⁻ ω, ∏ e ∈ S, f e (e ∈ ω) ∂(prodBernoulli p)
      = ∏ e ∈ S, ∫⁻ ω, f e (e ∈ ω) ∂(prodBernoulli p) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha ih =>
    have hstep : (fun ω : Set ι => ∏ e ∈ insert a S, f e (e ∈ ω))
        = fun ω => f a (a ∈ ω) * ∏ e ∈ S, f e (e ∈ ω) := by
      funext ω
      rw [Finset.prod_insert ha]
    have hdisj : Disjoint ({a} : Set ι) (↑S : Set ι) := by
      simp only [Set.disjoint_left, Set.mem_singleton_iff]
      exact fun x hx hxS => ha (hx ▸ Finset.mem_coe.mp hxS)
    have hind : Indep (coordSup ({a} : Set ι)) (coordSup (↑S : Set ι)) (prodBernoulli p) :=
      indep_coordSup p hdisj
    have h1 : Measurable[coordSup ({a} : Set ι)] (fun ω : Set ι => f a (a ∈ ω)) :=
      Measurable.mono (measurable_coordSigma_comp a (f a))
        (coordSigma_le_coordSup (Set.mem_singleton a)) le_rfl
    have h2 : Measurable[coordSup (↑S : Set ι)] (fun ω : Set ι => ∏ e ∈ S, f e (e ∈ ω)) :=
      measurable_coordSup_finset_prod S f
    refine Eq.trans (b := ∫⁻ ω, f a (a ∈ ω) * (∏ e ∈ S, f e (e ∈ ω)) ∂(prodBernoulli p)) ?_ ?_
    · rw [hstep]
    · refine Eq.trans (b := (∫⁻ ω, f a (a ∈ ω) ∂(prodBernoulli p))
          * ∫⁻ ω, ∏ e ∈ S, f e (e ∈ ω) ∂(prodBernoulli p)) ?_ ?_
      · exact lintegral_mul_eq_lintegral_mul_lintegral_of_independent_measurableSpace
          (Mf := coordSup ({a} : Set ι)) (Mg := coordSup (↑S : Set ι))
          (mΩ := (inferInstance : MeasurableSpace (Set ι))) (μ := prodBernoulli p)
          (f := fun ω : Set ι => f a (a ∈ ω)) (g := fun ω : Set ι => ∏ e ∈ S, f e (e ∈ ω))
          (coordSup_le _) (coordSup_le _) hind h1 h2
      · rw [Finset.prod_insert ha, ih]

end PercLib.Probability.AdaptedReveal

namespace PercLib.Probability.AdaptedReveal

variable {ι : Type*}

/-- The block restriction to a whole block is measurable for the coordinate `σ`-algebra of
that block. This is the direction that makes a history on an *infinite* revealed set a
function of the revealed coordinates. -/
theorem measurable_coordSup_blockRestrict (R : Set ι) :
    Measurable[coordSup R] (blockRestrict R) := by
  refine @Measurable.of_mem R (Set ι) (coordSup R) (blockRestrict R) ?_
  intro i
  exact Measurable.mono (measurable_coordSigma_comp (i : ι) (fun b : Prop => b))
    (coordSigma_le_coordSup i.2) le_rfl

/-- A history observable that only reads the revealed block is measurable for the
`σ`-algebra of the revealed coordinates. -/
theorem measurable_coordSup_blockRestrict_comp (R : Set ι) {β : Type*} [MeasurableSpace β]
    (F : Set R → β) (hF : Measurable F) :
    Measurable[coordSup R] (fun ω => F (blockRestrict R ω)) :=
  Measurable.comp (f := blockRestrict R) (g := F) hF (measurable_coordSup_blockRestrict R)

/-- Set integrals agree when the integrands agree on the set. -/
theorem setLintegral_congr_of_eq_on {μ : Measure (Set ι)} {s : Set (Set ι)}
    (hs : MeasurableSet s) {f g : Set ι → ℝ≥0∞} (h : ∀ ω ∈ s, f ω = g ω) :
    ∫⁻ ω in s, f ω ∂μ = ∫⁻ ω in s, g ω ∂μ := by
  rw [← lintegral_indicator hs, ← lintegral_indicator hs]
  exact lintegral_congr fun ω => by
    by_cases hω : ω ∈ s
    · simp only [Set.indicator_of_mem hω, h ω hω]
    · simp only [Set.indicator_of_notMem hω]

end PercLib.Probability.AdaptedReveal

namespace PercLib.Probability.AdaptedReveal

variable {ι : Type*} {St : Type*}

/-- Each state fibre is a measurable event. -/
theorem fiber_measurable (D : RevealData ι St) (σ : St) :
    MeasurableSet {ω : Set ι | D.state ω = σ} := by
  rw [D.fiber σ]
  exact (D.cyl_measurable σ).preimage (blockRestrict_measurable _)

variable [Countable St]

/-- The fresh monomial is the product over the finite coordinate set. -/
theorem freshMonomial_comp (S : Finset ι) (f : ι → Prop → ℝ≥0∞) (ω : Set ι) :
    freshMonomial S f (blockRestrict (↑S : Set ι) ω) = ∏ e ∈ S, f e (e ∈ ω) := by
  rw [freshMonomial, ← Finset.prod_attach (s := S) (f := fun x : ι => f x (x ∈ ω))]
  exact Finset.prod_congr rfl fun e _ => rfl

/-- A history observable, that is, a function of the state and of the co ordinates that
this state has revealed, is measurable for the canonical `σ`-algebra. -/
theorem measurable_history (D : RevealData ι St)
    (H : (σ : St) → Set (D.reveal σ) → ℝ≥0∞) (hH : ∀ σ, Measurable (H σ)) :
    Measurable fun ω => H (D.state ω) (blockRestrict (D.reveal (D.state ω)) ω) := by
  have hterm : ∀ σ : St, Measurable fun ω : Set ι =>
      ({ω | D.state ω = σ}.indicator
        (fun ω => H σ (blockRestrict (D.reveal σ) ω))) ω := fun σ =>
    (Measurable.comp (f := blockRestrict (D.reveal σ)) (g := H σ) (hH σ)
      (blockRestrict_measurable _)).indicator (fiber_measurable D σ)
  have hrep : (fun ω => H (D.state ω) (blockRestrict (D.reveal (D.state ω)) ω))
      = fun ω => ∑' σ : St, ({ω | D.state ω = σ}.indicator
          (fun ω => H σ (blockRestrict (D.reveal σ) ω))) ω := by
    funext ω
    rw [tsum_eq_single (D.state ω)]
    · exact (Set.indicator_of_mem (s := {ω_1 : Set ι | D.state ω_1 = D.state ω}) (f :=
        fun ω_1 => H (D.state ω) (blockRestrict (D.reveal (D.state ω)) ω_1)) rfl).symm
    · intro σ hσ
      exact Set.indicator_of_notMem (s := {ω_1 : Set ι | D.state ω_1 = σ})
        (f := fun ω_1 => H σ (blockRestrict (D.reveal σ) ω_1))
        (fun hmem => hσ hmem.symm)
  rw [hrep]
  exact Measurable.tsum hterm

/-- **Adapted-revelation factorization (CPI).** Let `D` be revelation data whose state
fibres are cylinder events on the revealed coordinates `D.reveal σ`. Let `G` be a history
observable (a function of the state and of the revealed coordinates), let `S σ` be a finite
set of *fresh* coordinates, disjoint from the revealed set of state `σ`, and let
`f e : Prop → ℝ≥0∞`. Then the joint expectation of the history and of the fresh monomial
`∏_{e ∈ S σ} f e (e open)` factorizes over the countable state partition.

The revealed set may be infinite, so this is usable with an unbounded-degree frontier;
nothing is assumed finite except the set of coordinates the fresh monomial actually reads. -/
theorem lintegral_adapted_prod (p : ι → unitInterval) (D : RevealData ι St)
    (G : Set ι → ℝ≥0∞) (H : (σ : St) → Set (D.reveal σ) → ℝ≥0∞)
    (hH : ∀ σ, Measurable (H σ))
    (hG : ∀ ω, G ω = H (D.state ω) (blockRestrict (D.reveal (D.state ω)) ω))
    (S : St → Finset ι) (hS : ∀ σ, Disjoint ((S σ : Finset ι) : Set ι) (D.reveal σ))
    (f : ι → Prop → ℝ≥0∞) :
    ∫⁻ ω, G ω * ∏ e ∈ S (D.state ω), f e (e ∈ ω) ∂(prodBernoulli p)
      = ∑' σ : St, (∫⁻ ω in {ω | D.state ω = σ}, G ω ∂(prodBernoulli p))
          * ∏ e ∈ S σ, ∫⁻ ω, f e (e ∈ ω) ∂(prodBernoulli p) := by
  classical
  have hfib : ∀ σ : St, MeasurableSet {ω : Set ι | D.state ω = σ} := fiber_measurable D
  have hdisj : Pairwise (Function.onFun Disjoint fun σ : St => {ω : Set ι | D.state ω = σ}) :=
    fun σ τ hστ => Set.disjoint_left.mpr fun ω hω hω' => hστ (hω.symm.trans hω')
  have hunion : (⋃ σ : St, {ω : Set ι | D.state ω = σ}) = Set.univ := by
    ext ω
    exact ⟨fun _ => Set.mem_univ _, fun _ => Set.mem_iUnion.mpr ⟨D.state ω, rfl⟩⟩
  set F : Set ι → ℝ≥0∞ := fun ω => G ω * ∏ e ∈ S (D.state ω), f e (e ∈ ω) with hF
  have hpartition : ∫⁻ ω, F ω ∂(prodBernoulli p)
      = ∑' σ : St, ∫⁻ ω in {ω | D.state ω = σ}, F ω ∂(prodBernoulli p) := by
    conv_rhs => rw [← lintegral_iUnion hfib hdisj F]
    rw [hunion]
    simp
  rw [hpartition]
  refine tsum_congr fun σ => ?_
  -- the history factor, extended by zero off the fibre
  set g : Set ι → ℝ≥0∞ := {ω : Set ι | D.state ω = σ}.indicator
    (fun ω => H σ (blockRestrict (D.reveal σ) ω)) with hg
  set P : Set ι → ℝ≥0∞ := fun ω => ∏ e ∈ S σ, f e (e ∈ ω) with hP
  have hset : MeasurableSet[coordSup (D.reveal σ)] {ω : Set ι | D.state ω = σ} := by
    rw [D.fiber σ]
    exact (D.cyl_measurable σ).preimage (measurable_coordSup_blockRestrict (D.reveal σ))
  have hg_meas : Measurable[coordSup (D.reveal σ)] g := by
    rw [hg]
    exact Measurable.indicator (m := coordSup (D.reveal σ))
      (measurable_coordSup_blockRestrict_comp (D.reveal σ) (H σ) (hH σ)) hset
  have hg_meas_ambient : Measurable g :=
    hg_meas.mono (coordSup_le _) le_rfl
  have hP_meas : Measurable[coordSup ((S σ : Finset ι) : Set ι)] P := by
    rw [hP]
    exact measurable_coordSup_finset_prod (S σ) f
  have hP_indep : Indep (coordSup (D.reveal σ)) (coordSup ((S σ : Finset ι) : Set ι))
      (prodBernoulli p) := (indep_coordSup p (hS σ)).symm
  -- on the fibre the extended history agrees with `G`
  have hpoint : ∫⁻ ω in {ω | D.state ω = σ}, G ω ∂(prodBernoulli p)
      = ∫⁻ ω, g ω ∂(prodBernoulli p) := by
    rw [← lintegral_indicator (hfib σ)]
    refine lintegral_congr fun ω => ?_
    by_cases h : ω ∈ {ω : Set ι | D.state ω = σ}
    · rw [hg, Set.indicator_of_mem h, Set.indicator_of_mem h, hG ω,
        show D.state ω = σ from h]
    · rw [hg, Set.indicator_of_notMem h, Set.indicator_of_notMem h]
  have hFg : ∫⁻ ω in {ω | D.state ω = σ}, F ω ∂(prodBernoulli p)
      = ∫⁻ ω, g ω * P ω ∂(prodBernoulli p) := by
    rw [← lintegral_indicator (hfib σ)]
    refine lintegral_congr fun ω => ?_
    by_cases h : ω ∈ {ω : Set ι | D.state ω = σ}
    · rw [hg, Set.indicator_of_mem h, Set.indicator_of_mem h]
      simp only [hF, hP]
      rw [hG ω, show D.state ω = σ from h]
    · rw [hg, Set.indicator_of_notMem h, Set.indicator_of_notMem h]
      simp
  rw [hFg, hpoint]
  refine Eq.trans (b := (∫⁻ ω, g ω ∂(prodBernoulli p))
      * ∫⁻ ω, P ω ∂(prodBernoulli p)) ?_ ?_
  · exact lintegral_mul_eq_lintegral_mul_lintegral_of_independent_measurableSpace
      (Mf := coordSup (D.reveal σ)) (Mg := coordSup ((S σ : Finset ι) : Set ι))
      (mΩ := (inferInstance : MeasurableSpace (Set ι))) (μ := prodBernoulli p)
      (f := g) (g := P) (coordSup_le _) (coordSup_le _) hP_indep hg_meas hP_meas
  · rw [hP, lintegral_prod_coord p (S σ) f]

end PercLib.Probability.AdaptedReveal
