/-!
# Adapted revelation data on the canonical Bernoulli law

The frontier argument of `PROOF.md` (accepted run `smwp9xgrt`) needs one probabilistic
input: conditionally on the past of an *adapted* revelation scheme, the unread
coordinates keep their product law.  The scheme reveals a random set `R` of
coordinates; the only thing that must be true is that the state of the scheme is a
function of the coordinates that it has already revealed.  That is the precise
"stopping set" content, and it is what `RevealData` records: a countable state type
`Σ`, a revealed set `D.reveal σ` for each state, and the assertion
`{ω | D.state ω = σ} = (fun ω => D.blockRestrict (D.reveal σ) ω) ⁻¹' D.cyl σ`
that the fibre of `σ` is a cylinder event on the revealed coordinates.

Nothing is assumed about the random revealed set beyond that; in particular the
revealed coordinates are not assumed finite, so the structure covers unbounded
degree frontiers.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory
open scoped ENNReal
open PercLib.Probability

namespace PercLib.Probability.AdaptedReveal

variable {ι : Type*}

/-- Restriction of a configuration to a fixed block `S` of coordinates. -/
def blockRestrict (S : Set ι) (ω : Set ι) : Set S := Subtype.val ⁻¹' ω

/-- The `σ`-algebra generated by a single coordinate. -/
@[instance_reducible] def coordSigma (e : ι) : MeasurableSpace (Set ι) :=
  MeasurableSpace.comap (fun ω : Set ι => e ∈ ω) (inferInstance : MeasurableSpace Prop)

/-- The fresh monomial `∏_{e ∈ S} f e (e is open)`, written as a function of the
restriction of the configuration to the block `S`. -/
def freshMonomial (S : Finset ι) (f : ι → Prop → ℝ≥0∞)
    (η : Set ↑(S : Set ι)) : ℝ≥0∞ :=
  ∏ e ∈ S.attach, f (e : ι) (e ∈ η)

/-- The one-coordinate factor `t` if the coordinate is open and `1` if it is closed.

Configurations are `Set ι`, so openness is a proposition; the `Decidable` instance is
fixed to `Classical.propDecidable` so that the factor can appear in statements. -/
noncomputable def powOpenFun (t : ℝ≥0∞) : Prop → ℝ≥0∞ :=
  fun b => @ite ℝ≥0∞ b (Classical.propDecidable b) t 1

/-- The same factor as a function of the configuration. -/
noncomputable def powOpen {ι : Type*} (t : ℝ≥0∞) (ω : Set ι) (e : ι) : ℝ≥0∞ :=
  powOpenFun t (e ∈ ω)

/-- The number of open coordinates of a finite coordinate set.

Uses an explicit classical decidability instance so that it can be written in statements
about an arbitrary configuration `ω : Set ι`. -/
noncomputable def openCount {ι : Type*} (S : Finset ι) (ω : Set ι) : ℕ :=
  @Finset.card ι (@Finset.filter ι (fun e => e ∈ ω) (Classical.decPred _) S)

/-- Adapted revelation data: a countably valued state, its revealed coordinate set, and
the statement that each state fibre is a cylinder event on the revealed coordinates.

This is the precise stopping-set hypothesis.  It is *not* automatic for a random set
`reveal`; it is what the exploration has to prove, and `RevealData` is the interface at
which that proof is consumed. -/
structure RevealData (ι : Type*) (St : Type*) where
  /-- The set of coordinates revealed in state `σ`. -/
  reveal : St → Set ι
  /-- The state of the scheme at the observation `ω`. -/
  state : Set ι → St
  /-- The cylindrical description of each fibre, on the revealed coordinates. -/
  cyl : (σ : St) → Set (Set (reveal σ))
  /-- The cylindrical description consists of measurable events. -/
  cyl_measurable : ∀ σ, MeasurableSet (cyl σ)
  /-- **Stopping-set property.** The fibre of `σ` is exactly the set of configurations
  whose revealed coordinates fall in `cyl σ`. -/
  fiber : ∀ σ, {ω | state ω = σ} = {ω | blockRestrict (reveal σ) ω ∈ cyl σ}

end PercLib.Probability.AdaptedReveal
