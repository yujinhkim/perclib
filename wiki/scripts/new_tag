#!/usr/bin/env node
// Apache-2.0. Reserve identities before inserting them into prose; never recycle.
(async () => {
  const fs = await import('node:fs/promises');
  const path = await import('node:path');
  const {randomInt} = await import('node:crypto');
  const {fileURLToPath} = await import('node:url');
  const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
  const {readRegistry, validateTags, readArticles} = await import('./articles.mjs');
  const args = process.argv.slice(2);
  if (args.length && !(args.length === 2 && args[0] === '--withdraw' && /^[0-9A-Z]{4}$/.test(args[1]))) {
    throw Error('Usage: wiki/scripts/new_tag [--withdraw XXXX]');
  }
  const lockPath = path.join(root, '.tags.lock');
  const lock = await fs.open(lockPath, 'wx');
  try {
    const registry = await readRegistry(root);
    // Validate the ledger without requiring every allocation to be used immediately.
    validateTags([], registry);
    const used = new Set(registry.tags.map(x => x.tag));
    let tag;
    if (args.length) {
      tag = args[1];
      const entry = registry.tags.find(x => x.tag === tag);
      if (!entry) throw Error(`Unknown tag: ${tag}`);
      const articles = await readArticles(root);
      if (articles.some(p => p.sections.some(s => s.html.includes(`id="tag-${tag}"`)))) throw Error(`Remove assertion ${tag} from prose before withdrawing it`);
      entry.state = 'withdrawn';
    } else {
      if (used.size >= 36 ** 4) throw Error('Tag space exhausted');
      do { tag = randomInt(36 ** 4).toString(36).toUpperCase().padStart(4, '0'); } while (used.has(tag));
      registry.tags.push({tag, state:'allocated'});
    }
    const target = path.join(root, 'tags.json');
    const temporary = `${target}.${process.pid}.tmp`;
    await fs.writeFile(temporary, JSON.stringify(registry, null, 2) + '\n', {flag:'wx'});
    await fs.rename(temporary, target);
    console.log(tag);
  } finally {
    await lock.close();
    await fs.unlink(lockPath);
  }
})().catch(error => {console.error(error.message); process.exitCode = 1;});
